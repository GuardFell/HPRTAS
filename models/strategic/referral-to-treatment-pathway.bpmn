<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_referral-to-treatment-pathway" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <!-- Strategic (high-level) view of the whole patient pathway. Every internal participant of the
     case study has its own lane and every external organisation is a black-box pool, so the
     division of responsibility and the points of external dependency are visible in one model.
     Executable detail is in models/operational/. -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hospital" name="Hospital Trust (specialist service)" processRef="referral-to-treatment-pathway" />
    <bpmn:participant id="Participant_ReferringOrganisation" name="Referring GP or another hospital" />
    <bpmn:participant id="Participant_SchedulingService" name="External scheduling service" />
    <bpmn:participant id="Participant_CorrespondenceService" name="External correspondence service" />
    <bpmn:participant id="Participant_TreatmentService" name="External treatment, laboratory and imaging service" />
    <bpmn:participant id="Participant_PaymentProvider" name="External Payment Service Provider" />
    <bpmn:participant id="Participant_FundingOrganisation" name="Funding organisation (insurer or commissioner)" />
    <bpmn:messageFlow id="MessageFlow_S1" name="referral letter and supporting documents" sourceRef="Participant_ReferringOrganisation" targetRef="StartEvent_ReferralReceived" />
    <bpmn:messageFlow id="MessageFlow_S2" name="request for missing information" sourceRef="Task_RequestMissingInformation" targetRef="Participant_ReferringOrganisation" />
    <bpmn:messageFlow id="MessageFlow_S3" name="availability request and booking" sourceRef="Task_ArrangeNewPatientAppointment" targetRef="Participant_SchedulingService" />
    <bpmn:messageFlow id="MessageFlow_S4" name="appointment letter or telephone contact" sourceRef="Task_ArrangeNewPatientAppointment" targetRef="Participant_CorrespondenceService" />
    <bpmn:messageFlow id="MessageFlow_S5" name="treatment, laboratory and imaging request" sourceRef="Task_CoordinateTreatment" targetRef="Participant_TreatmentService" />
    <bpmn:messageFlow id="MessageFlow_S6" name="payment and refund request or status" sourceRef="Task_DetermineFundingAndPayment" targetRef="Participant_PaymentProvider" />
    <bpmn:messageFlow id="MessageFlow_S7" name="funding approval request" sourceRef="Task_DetermineFundingAndPayment" targetRef="Participant_FundingOrganisation" />
    <bpmn:messageFlow id="MessageFlow_S8" name="clinic letter and follow-up correspondence" sourceRef="Task_DistributeLetter" targetRef="Participant_CorrespondenceService" />
  </bpmn:collaboration>
  <bpmn:process id="referral-to-treatment-pathway" name="Referral-to-treatment pathway (strategic view of all entities)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_MedicalSecretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>StartEvent_ReferralReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestMissingInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LetterOnTime</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consultants" name="Consultants">
        <bpmn:flowNodeRef>Task_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReferralDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReferralRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReferralRedirected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessAndAuthoriseTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BetweenCycleReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FitToContinue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareClinicLetter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OtherClinical" name="Other clinical professionals">
        <bpmn:flowNodeRef>Task_AuthoriseModification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CnsTeam" name="Clinical Nurse Specialist Team">
        <bpmn:flowNodeRef>StartEvent_PatientContactsCnsTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClinicalAdvice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CnsAdmin" name="Clinical Nurse Specialist Administrative Support Team">
        <bpmn:flowNodeRef>Task_ProvideAdministrativeSupport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EnquiryResolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OutpatientBookings" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>Task_ArrangeNewPatientAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AppointmentWithinPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowUpStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PathwayCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PathwayClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TreatmentBookings" name="Treatment and Chemotherapy Bookings Team">
        <bpmn:flowNodeRef>Task_CoordinateTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExternalServiceAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordPendingBooking</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CallHandling" name="Call Handling Team">
        <bpmn:flowNodeRef>StartEvent_EnquiryReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassifyEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EnquiryType</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PathwayCoordinators" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>Task_MonitorCorrespondence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OverdueDuration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewPathwayDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReminderIssued</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>Task_DetermineFundingAndPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessRefund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminManagement" name="Administrative Management Team">
        <bpmn:flowNodeRef>Task_ContactResponsibleConsultant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EscalatedToHigherManagement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LetterDelayResolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ReferralReceived" name="Referral received from a GP or another hospital" />
    <bpmn:task id="Task_CheckReferral" name="Check the referral and its supporting information" />
    <bpmn:task id="Task_RequestMissingInformation" name="Request missing information from the referring organisation" />
    <bpmn:task id="Task_DistributeLetter" name="Process and distribute the approved clinic letter" />
    <bpmn:exclusiveGateway id="Gateway_LetterOnTime" name="Letter completed within seven days?" />
    <bpmn:task id="Task_ClinicalReview" name="Clinically review the referral and record the decision" />
    <bpmn:exclusiveGateway id="Gateway_ReferralDecision" name="Referral decision?" />
    <bpmn:endEvent id="EndEvent_ReferralRejected" name="Referral rejected with the reason recorded" />
    <bpmn:endEvent id="EndEvent_ReferralRedirected" name="Referral redirected to another specialist service" />
    <bpmn:task id="Task_AssessAndAuthoriseTreatment" name="Assess the patient, record consent and authorise treatment" />
    <bpmn:task id="Task_BetweenCycleReview" name="Review the patient between treatment cycles" />
    <bpmn:exclusiveGateway id="Gateway_FitToContinue" name="Fit to continue, or treatment complete?" />
    <bpmn:task id="Task_PrepareClinicLetter" name="Prepare and approve the clinic letter" />
    <bpmn:task id="Task_AuthoriseModification" name="Authorise the treatment modification and support the plan" />
    <bpmn:startEvent id="StartEvent_PatientContactsCnsTeam" name="Patient contacts the Clinical Nurse Specialist Team directly" />
    <bpmn:task id="Task_ProvideClinicalAdvice" name="Provide clinical advice and treatment-related support" />
    <bpmn:task id="Task_ProvideAdministrativeSupport" name="Provide administrative support to the Clinical Nurse Specialist Team" />
    <bpmn:endEvent id="EndEvent_EnquiryResolved" name="Enquiry resolved and recorded" />
    <bpmn:task id="Task_ArrangeNewPatientAppointment" name="Arrange the new patient appointment and inform the patient" />
    <bpmn:exclusiveGateway id="Gateway_AppointmentWithinPeriod" name="Suitable appointment within the requested period?" />
    <bpmn:task id="Task_ArrangeFollowUp" name="Arrange the follow-up appointment" />
    <bpmn:exclusiveGateway id="Gateway_FollowUpStatus" name="Was the appointment attended?" />
    <bpmn:endEvent id="EndEvent_PathwayCompleted" name="Patient pathway completed" />
    <bpmn:endEvent id="EndEvent_PathwayClosed" name="Pathway closed or patient discharged" />
    <bpmn:task id="Task_CoordinateTreatment" name="Coordinate the treatment appointments with hospital and external services" />
    <bpmn:exclusiveGateway id="Gateway_ExternalServiceAvailable" name="External service available?" />
    <bpmn:task id="Task_RecordPendingBooking" name="Keep the booking pending and notify the responsible team" />
    <bpmn:startEvent id="StartEvent_EnquiryReceived" name="Patient or referrer contacts the hospital" />
    <bpmn:task id="Task_ClassifyEnquiry" name="Classify and record the enquiry" />
    <bpmn:exclusiveGateway id="Gateway_EnquiryType" name="Type of enquiry?" />
    <bpmn:task id="Task_MonitorCorrespondence" name="Monitor outstanding correspondence and issue weekly reminders" />
    <bpmn:exclusiveGateway id="Gateway_OverdueDuration" name="How long has the letter been outstanding?" />
    <bpmn:task id="Task_ReviewPathwayDelay" name="Review the delay and re-plan the appointment" />
    <bpmn:endEvent id="EndEvent_ReminderIssued" name="Reminder issued and the letter is monitored" />
    <bpmn:task id="Task_DetermineFundingAndPayment" name="Determine the funding route and handle payment" />
    <bpmn:task id="Task_ProcessRefund" name="Process a refund for a cancelled or changed appointment" />
    <bpmn:task id="Task_ContactResponsibleConsultant" name="Contact the responsible consultant and resolve the delay" />
    <bpmn:endEvent id="EndEvent_EscalatedToHigherManagement" name="Escalated to higher management" />
    <bpmn:endEvent id="EndEvent_LetterDelayResolved" name="Letter delay resolved through management action" />
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="StartEvent_ReferralReceived" targetRef="Task_CheckReferral" />
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_CheckReferral" targetRef="Task_ClinicalReview" />
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_ClinicalReview" targetRef="Gateway_ReferralDecision" />
    <bpmn:sequenceFlow id="Flow_S4" name="accepted" sourceRef="Gateway_ReferralDecision" targetRef="Task_ArrangeNewPatientAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;accepted&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S5" name="rejected" sourceRef="Gateway_ReferralDecision" targetRef="EndEvent_ReferralRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;rejected&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S6" name="redirected" sourceRef="Gateway_ReferralDecision" targetRef="EndEvent_ReferralRedirected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;redirected&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S7" name="further information" sourceRef="Gateway_ReferralDecision" targetRef="Task_RequestMissingInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;further_information&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S8" sourceRef="Task_RequestMissingInformation" targetRef="Task_CheckReferral" />
    <bpmn:sequenceFlow id="Flow_S9" sourceRef="Task_ArrangeNewPatientAppointment" targetRef="Gateway_AppointmentWithinPeriod" />
    <bpmn:sequenceFlow id="Flow_S10" name="yes" sourceRef="Gateway_AppointmentWithinPeriod" targetRef="Task_AssessAndAuthoriseTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable = true and withinRequestedWindow = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S11" name="no" sourceRef="Gateway_AppointmentWithinPeriod" targetRef="Task_ReviewPathwayDelay" />
    <bpmn:sequenceFlow id="Flow_S12" sourceRef="Task_ReviewPathwayDelay" targetRef="Task_ArrangeNewPatientAppointment" />
    <bpmn:sequenceFlow id="Flow_S13" sourceRef="Task_AssessAndAuthoriseTreatment" targetRef="Task_DetermineFundingAndPayment" />
    <bpmn:sequenceFlow id="Flow_S14" sourceRef="Task_DetermineFundingAndPayment" targetRef="Task_CoordinateTreatment" />
    <bpmn:sequenceFlow id="Flow_S15" sourceRef="Task_CoordinateTreatment" targetRef="Gateway_ExternalServiceAvailable" />
    <bpmn:sequenceFlow id="Flow_S16" name="yes" sourceRef="Gateway_ExternalServiceAvailable" targetRef="Task_BetweenCycleReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalServiceAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S17" name="no" sourceRef="Gateway_ExternalServiceAvailable" targetRef="Task_RecordPendingBooking" />
    <bpmn:sequenceFlow id="Flow_S18" sourceRef="Task_RecordPendingBooking" targetRef="Task_CoordinateTreatment" />
    <bpmn:sequenceFlow id="Flow_S19" sourceRef="Task_BetweenCycleReview" targetRef="Gateway_FitToContinue" />
    <bpmn:sequenceFlow id="Flow_S20" name="more cycles" sourceRef="Gateway_FitToContinue" targetRef="Task_BetweenCycleReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentDecision = &quot;continue&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S21" name="not fit or changed" sourceRef="Gateway_FitToContinue" targetRef="Task_AuthoriseModification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentDecision = &quot;delay_or_change&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S22" name="treatment complete" sourceRef="Gateway_FitToContinue" targetRef="Task_PrepareClinicLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentDecision = &quot;complete&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S23" sourceRef="Task_AuthoriseModification" targetRef="Task_DetermineFundingAndPayment" />
    <bpmn:sequenceFlow id="Flow_S24" sourceRef="Task_PrepareClinicLetter" targetRef="Task_DistributeLetter" />
    <bpmn:sequenceFlow id="Flow_S25" sourceRef="Task_DistributeLetter" targetRef="Gateway_LetterOnTime" />
    <bpmn:sequenceFlow id="Flow_S26" name="yes" sourceRef="Gateway_LetterOnTime" targetRef="Task_ArrangeFollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterWithinSevenDays = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S27" name="delayed" sourceRef="Gateway_LetterOnTime" targetRef="Task_MonitorCorrespondence" />
    <bpmn:sequenceFlow id="Flow_S28" sourceRef="Task_ArrangeFollowUp" targetRef="Gateway_FollowUpStatus" />
    <bpmn:sequenceFlow id="Flow_S29" name="attended" sourceRef="Gateway_FollowUpStatus" targetRef="EndEvent_PathwayCompleted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentStatus = &quot;attended&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S30" name="cancelled or not attended" sourceRef="Gateway_FollowUpStatus" targetRef="Task_ProcessRefund" />
    <bpmn:sequenceFlow id="Flow_S31" sourceRef="Task_ProcessRefund" targetRef="EndEvent_PathwayClosed" />
    <bpmn:sequenceFlow id="Flow_S32" sourceRef="Task_MonitorCorrespondence" targetRef="Gateway_OverdueDuration" />
    <bpmn:sequenceFlow id="Flow_S33" name="more than one month" sourceRef="Gateway_OverdueDuration" targetRef="Task_ContactResponsibleConsultant">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= overdueDuration = &quot;over_one_month&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S34" name="more than three months" sourceRef="Gateway_OverdueDuration" targetRef="EndEvent_EscalatedToHigherManagement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= overdueDuration = &quot;over_three_months&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S35" name="within one month" sourceRef="Gateway_OverdueDuration" targetRef="EndEvent_ReminderIssued" />
    <bpmn:sequenceFlow id="Flow_S36" sourceRef="Task_ContactResponsibleConsultant" targetRef="EndEvent_LetterDelayResolved" />
    <bpmn:sequenceFlow id="Flow_S37" sourceRef="StartEvent_EnquiryReceived" targetRef="Task_ClassifyEnquiry" />
    <bpmn:sequenceFlow id="Flow_S38" sourceRef="Task_ClassifyEnquiry" targetRef="Gateway_EnquiryType" />
    <bpmn:sequenceFlow id="Flow_S39" name="administrative" sourceRef="Gateway_EnquiryType" targetRef="Task_ArrangeNewPatientAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryType = &quot;administrative&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S40" name="financial" sourceRef="Gateway_EnquiryType" targetRef="Task_DetermineFundingAndPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryType = &quot;financial&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S41" name="clinical" sourceRef="Gateway_EnquiryType" targetRef="Task_ProvideClinicalAdvice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryType = &quot;clinical&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S42" sourceRef="StartEvent_PatientContactsCnsTeam" targetRef="Task_ProvideClinicalAdvice" />
    <bpmn:sequenceFlow id="Flow_S43" sourceRef="Task_ProvideClinicalAdvice" targetRef="Task_ProvideAdministrativeSupport" />
    <bpmn:sequenceFlow id="Flow_S44" sourceRef="Task_ProvideAdministrativeSupport" targetRef="EndEvent_EnquiryResolved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Hospital_di" bpmnElement="Participant_Hospital" isHorizontal="true">
        <dc:Bounds x="140" y="140" width="5470" height="1480" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="150" y="1626" width="200" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_MedicalSecretaries_di" bpmnElement="Lane_MedicalSecretaries" isHorizontal="true">
        <dc:Bounds x="140" y="170" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Consultants_di" bpmnElement="Lane_Consultants" isHorizontal="true">
        <dc:Bounds x="140" y="300" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OtherClinical_di" bpmnElement="Lane_OtherClinical" isHorizontal="true">
        <dc:Bounds x="140" y="430" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CnsTeam_di" bpmnElement="Lane_CnsTeam" isHorizontal="true">
        <dc:Bounds x="140" y="560" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CnsAdmin_di" bpmnElement="Lane_CnsAdmin" isHorizontal="true">
        <dc:Bounds x="140" y="690" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OutpatientBookings_di" bpmnElement="Lane_OutpatientBookings" isHorizontal="true">
        <dc:Bounds x="140" y="820" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_TreatmentBookings_di" bpmnElement="Lane_TreatmentBookings" isHorizontal="true">
        <dc:Bounds x="140" y="950" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CallHandling_di" bpmnElement="Lane_CallHandling" isHorizontal="true">
        <dc:Bounds x="140" y="1080" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PathwayCoordinators_di" bpmnElement="Lane_PathwayCoordinators" isHorizontal="true">
        <dc:Bounds x="140" y="1210" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Finance_di" bpmnElement="Lane_Finance" isHorizontal="true">
        <dc:Bounds x="140" y="1340" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AdminManagement_di" bpmnElement="Lane_AdminManagement" isHorizontal="true">
        <dc:Bounds x="140" y="1470" width="5470" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_ReferringOrganisation_di" bpmnElement="Participant_ReferringOrganisation" isHorizontal="true">
        <dc:Bounds x="5810" y="205" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_SchedulingService_di" bpmnElement="Participant_SchedulingService" isHorizontal="true">
        <dc:Bounds x="5810" y="855" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_CorrespondenceService_di" bpmnElement="Participant_CorrespondenceService" isHorizontal="true">
        <dc:Bounds x="5810" y="295" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_TreatmentService_di" bpmnElement="Participant_TreatmentService" isHorizontal="true">
        <dc:Bounds x="5810" y="985" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_PaymentProvider_di" bpmnElement="Participant_PaymentProvider" isHorizontal="true">
        <dc:Bounds x="5810" y="1375" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_FundingOrganisation_di" bpmnElement="Participant_FundingOrganisation" isHorizontal="true">
        <dc:Bounds x="5810" y="1465" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_ReferralReceived_di" bpmnElement="StartEvent_ReferralReceived">
        <dc:Bounds x="227" y="217" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="76" y="259" width="338" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckReferral_di" bpmnElement="Task_CheckReferral">
        <dc:Bounds x="345" y="195" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="225" y="281" width="340" height="20" />
        </bpmndi:BPMNLabel>

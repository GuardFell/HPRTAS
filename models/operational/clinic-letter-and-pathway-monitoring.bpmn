<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_clinic-letter-and-pathway-monitoring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hospital" name="Hospital Trust" processRef="clinic-letter-and-pathway-monitoring" />
    <bpmn:participant id="Participant_CorrespondenceService" name="Correspondence service" />
    <bpmn:participant id="Participant_SchedulingService" name="Scheduling service" />
    <bpmn:participant id="Participant_PaymentProvider" name="Payment Service Provider" />
    <bpmn:messageFlow id="MessageFlow_C1" name="clinic letter" sourceRef="ServiceTask_DispatchClinicLetter" targetRef="Participant_CorrespondenceService" />
    <bpmn:messageFlow id="MessageFlow_C2" name="availability request" sourceRef="ServiceTask_CheckFollowUpAvailability" targetRef="Participant_SchedulingService" />
    <bpmn:messageFlow id="MessageFlow_C3" name="refund request" sourceRef="UserTask_SendRefundRequest" targetRef="Participant_PaymentProvider" />
  </bpmn:collaboration>
  <bpmn:error id="Error_InvalidVariable" name="INVALID_VARIABLE" errorCode="INVALID_VARIABLE" />
  <bpmn:process id="clinic-letter-and-pathway-monitoring" name="Clinic letter approval, distribution, pathway monitoring and follow-up" isExecutable="true">    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>UserTask_DetermineRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendRefundRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordRefundResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RefundRecorded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OutpatientBookings" name="Outpatient Bookings">
        <bpmn:flowNodeRef>Boundary_Error_FollowUpBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckFollowUpAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowUpWithinPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FollowUpReferred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConfirmFollowUpAndInformPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowUpStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PathwayCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordCancellationOrNonAttendance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaidAppointmentAffected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OfferAnotherAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PathwayClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ArrangeFollowUpAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReferToPathwayTeam</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminManagement" name="Administrative Management">
        <bpmn:flowNodeRef>UserTask_ContactResponsibleConsultant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LetterDelayResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EscalatedToHigherManagement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PathwayCoordinators" name="Pathway Coordinators">
        <bpmn:flowNodeRef>UserTask_ReviewOutstandingCorrespondence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OverdueDuration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReminderIssued</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>Boundary_Error_LetterDispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ProcessAndDistributeLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_DispatchClinicLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LetterOnTime</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Clinical" name="Clinical Team">
        <bpmn:flowNodeRef>StartEvent_ConsultationCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PrepareAndApproveClinicLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Timer_Letter</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ConsultationCompleted" name="Consultation completed" />
    <bpmn:userTask id="UserTask_PrepareAndApproveClinicLetter" name="Approve clinic letter" camunda:formKey="camunda:form:forms/clinic-letter.form">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_ProcessAndDistributeLetter" name="Process letter and recipients">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_DispatchClinicLetter" name="Send clinic letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-correspondence" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_LetterOnTime" name="Letter within 7 days?" default="Flow_C6" />
    <bpmn:userTask id="UserTask_ReviewOutstandingCorrespondence" name="Review reminders">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_OverdueDuration" name="Overdue how long?" default="Flow_C11" />
    <bpmn:endEvent id="EndEvent_ReminderIssued" name="Reminder issued" />
    <bpmn:userTask id="UserTask_ContactResponsibleConsultant" name="Contact responsible consultant">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="administrative-management" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_LetterDelayResolved" name="Delay resolved" />
    <bpmn:endEvent id="EndEvent_EscalatedToHigherManagement" name="Escalated higher" />
    <bpmn:serviceTask id="ServiceTask_CheckFollowUpAvailability" name="Check availability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-appointment-availability" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FollowUpWithinPeriod" name="In requested period?" />
    <bpmn:endEvent id="EndEvent_FollowUpReferred" name="Follow-up referred" />
    <bpmn:userTask id="UserTask_ConfirmFollowUpAndInformPatient" name="Confirm and inform patient">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1csb1ko</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FollowUpStatus" name="Appointment status?" default="Flow_C20" />
    <bpmn:endEvent id="EndEvent_PathwayCompleted" name="Pathway completed" />
    <bpmn:userTask id="UserTask_RecordCancellationOrNonAttendance" name="Record cancellation" camunda:formKey="camunda:form:forms/patient-contact.form">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PaidAppointmentAffected" name="Paid appointment?" default="Flow_C23" />
    <bpmn:exclusiveGateway id="Gateway_OfferAnotherAppointment" name="Offer another?" default="Flow_C28" />
    <bpmn:endEvent id="EndEvent_PathwayClosed" name="Pathway closed" />
    <bpmn:userTask id="UserTask_DetermineRefund" name="Determine refund" camunda:formKey="camunda:form:forms/refund.form">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_SendRefundRequest" name="Send refund request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_RecordRefundResult" name="Record refund">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_RefundRecorded" name="Refund recorded" />
    <bpmn:userTask id="UserTask_ArrangeFollowUpAppointment" name="Arrange follow-up">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_ReferToPathwayTeam" name="Refer to pathway team">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C15</bpmn:incoming>
      <bpmn:outgoing>Flow_1csb1ko</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_Timer_Letter" name="7 days" attachedToRef="UserTask_PrepareAndApproveClinicLetter">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Error_LetterDispatch" name="invalid dispatch request" attachedToRef="ServiceTask_DispatchClinicLetter">
      <bpmn:errorEventDefinition errorRef="Error_InvalidVariable" />
    </bpmn:boundaryEvent>

    <bpmn:boundaryEvent id="Boundary_Error_FollowUpBooking" name="invalid follow-up booking" attachedToRef="ServiceTask_CheckFollowUpAvailability">
      <bpmn:errorEventDefinition errorRef="Error_InvalidVariable" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_ConsultationCompleted" targetRef="UserTask_PrepareAndApproveClinicLetter" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="UserTask_PrepareAndApproveClinicLetter" targetRef="UserTask_ProcessAndDistributeLetter" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="UserTask_ProcessAndDistributeLetter" targetRef="ServiceTask_DispatchClinicLetter" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="ServiceTask_DispatchClinicLetter" targetRef="Gateway_LetterOnTime" />
    <bpmn:sequenceFlow id="Flow_C5" name="on time" sourceRef="Gateway_LetterOnTime" targetRef="UserTask_ArrangeFollowUpAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterWithinSevenDays = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C6" name="delayed" sourceRef="Gateway_LetterOnTime" targetRef="UserTask_ReviewOutstandingCorrespondence" />
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Boundary_Timer_Letter" targetRef="UserTask_ReviewOutstandingCorrespondence" />
    <bpmn:sequenceFlow id="Flow_C28_LetterDispatchError" sourceRef="Boundary_Error_LetterDispatch" targetRef="UserTask_ProcessAndDistributeLetter" />
    <bpmn:sequenceFlow id="Flow_C29_FollowUpBookingError" sourceRef="Boundary_Error_FollowUpBooking" targetRef="UserTask_ArrangeFollowUpAppointment" />
    <bpmn:sequenceFlow id="Flow_C8" sourceRef="UserTask_ReviewOutstandingCorrespondence" targetRef="Gateway_OverdueDuration" />
    <bpmn:sequenceFlow id="Flow_C9" name="1 month" sourceRef="Gateway_OverdueDuration" targetRef="UserTask_ContactResponsibleConsultant">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= overdueDuration = "over_one_month"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C10" name="3 months" sourceRef="Gateway_OverdueDuration" targetRef="EndEvent_EscalatedToHigherManagement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= overdueDuration = "over_three_months"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C11" name="&lt; 1 month" sourceRef="Gateway_OverdueDuration" targetRef="EndEvent_ReminderIssued" />
    <bpmn:sequenceFlow id="Flow_C12" sourceRef="UserTask_ContactResponsibleConsultant" targetRef="EndEvent_LetterDelayResolved" />
    <bpmn:sequenceFlow id="Flow_C13" sourceRef="UserTask_ArrangeFollowUpAppointment" targetRef="ServiceTask_CheckFollowUpAvailability" />
    <bpmn:sequenceFlow id="Flow_C14" sourceRef="ServiceTask_CheckFollowUpAvailability" targetRef="Gateway_FollowUpWithinPeriod" />
    <bpmn:sequenceFlow id="Flow_C15" name="in period" sourceRef="Gateway_FollowUpWithinPeriod" targetRef="UserTask_ReferToPathwayTeam">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= withinRequestedWindow = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C17" sourceRef="UserTask_ReferToPathwayTeam" targetRef="EndEvent_FollowUpReferred" />
    <bpmn:sequenceFlow id="Flow_1csb1ko" sourceRef="UserTask_ReferToPathwayTeam" targetRef="UserTask_ConfirmFollowUpAndInformPatient" />
    <bpmn:sequenceFlow id="Flow_C18" sourceRef="UserTask_ConfirmFollowUpAndInformPatient" targetRef="Gateway_FollowUpStatus" />
    <bpmn:sequenceFlow id="Flow_C19" name="attended" sourceRef="Gateway_FollowUpStatus" targetRef="EndEvent_PathwayCompleted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentStatus = "attended"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C20" name="cancelled" sourceRef="Gateway_FollowUpStatus" targetRef="UserTask_RecordCancellationOrNonAttendance" />
    <bpmn:sequenceFlow id="Flow_C21" sourceRef="UserTask_RecordCancellationOrNonAttendance" targetRef="Gateway_PaidAppointmentAffected" />
    <bpmn:sequenceFlow id="Flow_C22" name="paid" sourceRef="Gateway_PaidAppointmentAffected" targetRef="UserTask_DetermineRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paidAppointment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C23" name="not paid" sourceRef="Gateway_PaidAppointmentAffected" targetRef="Gateway_OfferAnotherAppointment" />
    <bpmn:sequenceFlow id="Flow_C27" name="yes" sourceRef="Gateway_OfferAnotherAppointment" targetRef="UserTask_ArrangeFollowUpAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= offerAnotherAppointment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C28" name="no" sourceRef="Gateway_OfferAnotherAppointment" targetRef="EndEvent_PathwayClosed" />
    <bpmn:sequenceFlow id="Flow_C24" sourceRef="UserTask_DetermineRefund" targetRef="UserTask_SendRefundRequest" />
    <bpmn:sequenceFlow id="Flow_C25" sourceRef="UserTask_SendRefundRequest" targetRef="UserTask_RecordRefundResult" />
    <bpmn:sequenceFlow id="Flow_C26" sourceRef="UserTask_RecordRefundResult" targetRef="EndEvent_RefundRecorded" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

        <bpmndi:BPMNLabel>
        <dc:Bounds x="148" y="938" width="174" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CnsAdmin_di" bpmnElement="Lane_CnsAdmin" isHorizontal="true">

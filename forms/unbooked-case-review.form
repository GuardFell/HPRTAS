{
  "id": "unbooked-case-review",
  "components": [
    {
      "type": "group",
      "label": "Unbooked Case",
      "components": [
        {
          "type": "textfield",
          "key": "patientId",
          "label": "Patient ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "textfield",
          "key": "highlightedTo",
          "label": "Highlighted To",
          "description": "The pathway team the case is referred to.",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "select",
          "key": "reviewOutcome",
          "label": "Outcome of the Review",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Awaiting the Pathway Team",
              "value": "awaiting_pathway_decision"
            },
            {
              "label": "Referred On",
              "value": "referred_on"
            },
            {
              "label": "Case Closed",
              "value": "closed"
            }
          ]
        },
        {
          "type": "datetime",
          "subtype": "date",
          "dateLabel": "Date",
          "key": "reviewDate",
          "label": "Review Date",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textfield",
          "key": "reviewedBy",
          "label": "Reviewed By",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textarea",
          "key": "reviewNotes",
          "label": "Notes",
          "validate": {
            "maxLength": 2000
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_TreatmentBookings_di" bpmnElement="Lane_TreatmentBookings" isHorizontal="true">
        <dc:Bounds x="140" y="1530" width="6790" height="200" />
        <bpmndi:BPMNLabel>
        <dc:Bounds x="148" y="1538" width="174" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CallHandling_di" bpmnElement="Lane_CallHandling" isHorizontal="true">
        <dc:Bounds x="140" y="1730" width="6790" height="200" />
        <bpmndi:BPMNLabel>
        <dc:Bounds x="148" y="1738" width="174" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PathwayCoordinators_di" bpmnElement="Lane_PathwayCoordinators" isHorizontal="true">
        <dc:Bounds x="140" y="1930" width="6790" height="200" />
        <bpmndi:BPMNLabel>
        <dc:Bounds x="148" y="1938" width="174" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Finance_di" bpmnElement="Lane_Finance" isHorizontal="true">
        <dc:Bounds x="140" y="2130" width="6790" height="200" />
        <bpmndi:BPMNLabel>
        <dc:Bounds x="148" y="2138" width="174" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AdminManagement_di" bpmnElement="Lane_AdminManagement" isHorizontal="true">
        <dc:Bounds x="140" y="2330" width="6790" height="200" />
        <bpmndi:BPMNLabel>
        <dc:Bounds x="148" y="2338" width="174" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_ReferringOrganisation_di" bpmnElement="Participant_ReferringOrganisation" isHorizontal="true">
        <dc:Bounds x="7130" y="400" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_SchedulingService_di" bpmnElement="Participant_SchedulingService" isHorizontal="true">
        <dc:Bounds x="7130" y="1400" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_CorrespondenceService_di" bpmnElement="Participant_CorrespondenceService" isHorizontal="true">
        <dc:Bounds x="7130" y="1490" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_TreatmentService_di" bpmnElement="Participant_TreatmentService" isHorizontal="true">
        <dc:Bounds x="7130" y="1600" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_PaymentProvider_di" bpmnElement="Participant_PaymentProvider" isHorizontal="true">

{
  "id": "delay-review",
  "components": [
    {
      "type": "group",
      "label": "Delay Review",
      "components": [
        {
          "type": "textfield",
          "key": "referralId",
          "label": "Referral ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "textfield",
          "key": "patientId",
          "label": "Patient ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "select",
          "key": "delayReviewOutcome",
          "label": "Outcome of the Review",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Kept Under Monitoring",
              "value": "monitoring"
            },
            {
              "label": "Expedited with the Service",
              "value": "expedited"
            },
            {
              "label": "Returned to the Referring Organisation",
              "value": "returned_to_referrer"
            }
          ]
        },
        {
          "type": "checkbox",
          "key": "referredToPathwayTeam",
          "label": "Referred to the Pathway Team"
        },
        {
          "type": "textfield",
          "key": "reviewedBy",
          "label": "Reviewed By",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textarea",
          "key": "delayReviewNotes",
          "label": "Notes",
          "validate": {
            "maxLength": 2000
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

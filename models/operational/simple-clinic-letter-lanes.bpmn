<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_simple_letter" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:error id="Error_INVALID_VARIABLE" name="INVALID_VARIABLE" errorCode="INVALID_VARIABLE" />
  <bpmn:message id="Message_LetterOutstanding" name="letter outstanding" />
  <bpmn:collaboration id="Collaboration_letter">
    <bpmn:participant id="Participant_Hospital" name="Hospital" processRef="simple-clinic-letter-lanes" />
  </bpmn:collaboration>
  <bpmn:process id="simple-clinic-letter-lanes" name="Clinic Letter Production and Distribution" isExecutable="true">
    <bpmn:documentation>Covers FR-036 to FR-040 and BR-26 to BR-33, EX-17, EX-18: the Consultant owns and approves the clinical content of a clinic letter, administrative staff may correct formatting but not clinical meaning, a letter outstanding beyond seven days enters pathway monitoring, reminders stop once the letter is complete and the history is retained. This is the lane-level view of the same process core-3 executes. send-correspondence uses the job type and the variable contract of workers/README.md and carries a catch event for INVALID_VARIABLE.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Consultants" name="Consultants">
        <bpmn:flowNodeRef>StartEvent_ConsultationCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_PrepareLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_ApproveLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_ReviewClinicalError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_C_LetterOverdue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MedicalSecretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>N_MS_AdminCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_SendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_ErrorDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LetterSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_DispatchFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_MS_DispatchFailure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PathwayCoordinators" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>StartEvent_Delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_MonitorDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_WeeklyReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_DelayLevel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminManagement" name="Administrative Management Team">
        <bpmn:flowNodeRef>N_AM_EscalateManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_AM_EscalateHigher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Escalated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ConsultationCompleted" name="Consultation or treatment review completed">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_Delay" name="Clinic letter outstanding">
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_LetterOutstanding" messageRef="Message_LetterOutstanding" />
    </bpmn:startEvent>
    <bpmn:userTask id="N_C_PrepareLetter" name="Prepare clinic letter">
      <bpmn:documentation>BR-26: the Consultant prepares the clinical content of the clinic letter and identifies its recipients (FR-036).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="clinic-letter-prepare" />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_C_ApproveLetter" name="Approve clinic letter">
      <bpmn:documentation>BR-26: the clinical content of a clinic letter is approved by the Consultant before it can be distributed (FR-036).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="clinic-letter-approve" />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_C_ReviewClinicalError" name="Review the suspected clinical error">
      <bpmn:documentation>BR-27 and EX-18: a suspected clinical error is returned to the Consultant for review; administrative staff may not change clinical meaning (FR-037).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="letter-correction" />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_MS_AdminCheck" name="Administrative check">
      <bpmn:documentation>Step 11: the Medical Secretaries check the letter administratively and confirm the recipients (FR-037).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="admin-check" />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
      </bpmn:extensionElements>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="N_MS_SendLetter" name="Send the letter to recipients">
      <bpmn:documentation>Job type send-correspondence (worker correspondence-dispatch; simulates the external correspondence service). Input: recipients, documentType, channelPreference. Output: dispatchDate, dispatchChannel, dispatchReference. Error: INVALID_VARIABLE (FR-039, NFR-011).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-correspondence" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="N_PC_MonitorDelay" name="Review outstanding letter">
      <bpmn:documentation>EX-17: a clinic letter outstanding more than seven days after the appointment is treated as delayed and enters pathway monitoring (BR-28, FR-038). Reached either by the seven-day boundary event on the approval, or by the outstanding-letter message.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="delay-review" />
        <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
      </bpmn:extensionElements>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_PC_WeeklyReminder" name="Send weekly reminder">
      <bpmn:documentation>EX-17: weekly reminders are issued while the letter is outstanding and stop once it is complete (FR-040).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="weekly-reminder" />
        <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
      </bpmn:extensionElements>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_AM_EscalateManager" name="Escalate to manager">
      <bpmn:documentation>EX-17: escalation to the Administrative Manager, who contacts the responsible Consultant (BR-32, FR-040).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="escalation-manager" />
        <zeebe:assignmentDefinition candidateGroups="administrative-management" />
      </bpmn:extensionElements>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_AM_EscalateHigher" name="Escalate higher">
      <bpmn:documentation>EX-17: further escalation to the higher management team (BR-32, FR-040).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="escalation-higher" />
        <zeebe:assignmentDefinition candidateGroups="administrative-management" />
      </bpmn:extensionElements>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_MS_ErrorDecision" name="Suspected clinical error?" default="F6">
      <bpmn:documentation>BR-27, EX-18: return the letter to the Consultant or continue to distribution (FR-037).</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="N_PC_DelayLevel" name="How overdue is the letter?" default="F11">
      <bpmn:documentation>EX-17: weekly reminders while the letter is outstanding, escalation once the delay is over three months (BR-32).</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="B_C_LetterOverdue" name="seven days elapsed" attachedToRef="N_C_ApproveLetter">
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_MS_DispatchFailure" name="dispatch failed" attachedToRef="N_MS_SendLetter">
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_INVALID_VARIABLE" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_LetterSent" name="Letter sent">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_DispatchFailed" name="Letter dispatch failed">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Escalated" name="Letter escalated">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent_ConsultationCompleted" targetRef="N_C_PrepareLetter" />
    <bpmn:sequenceFlow id="F2" sourceRef="N_C_PrepareLetter" targetRef="N_C_ApproveLetter" />
    <bpmn:sequenceFlow id="F3" sourceRef="N_C_ApproveLetter" targetRef="N_MS_AdminCheck" />
    <bpmn:sequenceFlow id="F4" sourceRef="N_MS_AdminCheck" targetRef="N_MS_ErrorDecision" />
    <bpmn:sequenceFlow id="F5" sourceRef="N_MS_ErrorDecision" targetRef="N_MS_SendLetter" name="no clinical error">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suspectedClinicalError = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="N_MS_ErrorDecision" targetRef="N_C_ReviewClinicalError" name="clinical error suspected" />
    <bpmn:sequenceFlow id="F7" sourceRef="N_C_ReviewClinicalError" targetRef="N_C_ApproveLetter" />
    <bpmn:sequenceFlow id="F8" sourceRef="N_MS_SendLetter" targetRef="EndEvent_LetterSent" />
    <bpmn:sequenceFlow id="F9" sourceRef="StartEvent_Delay" targetRef="N_PC_MonitorDelay" />
    <bpmn:sequenceFlow id="F10" sourceRef="N_PC_MonitorDelay" targetRef="N_PC_DelayLevel" />
    <bpmn:sequenceFlow id="F11" sourceRef="N_PC_DelayLevel" targetRef="N_PC_WeeklyReminder" name="less than three months" />
    <bpmn:sequenceFlow id="F12" sourceRef="N_PC_DelayLevel" targetRef="N_AM_EscalateManager" name="over three months">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= overdueDuration = "over_three_months"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="N_PC_WeeklyReminder" targetRef="EndEvent_Escalated" />
    <bpmn:sequenceFlow id="F14" sourceRef="N_AM_EscalateManager" targetRef="N_AM_EscalateHigher" />
    <bpmn:sequenceFlow id="F15" sourceRef="N_AM_EscalateHigher" targetRef="EndEvent_Escalated" />
    <bpmn:sequenceFlow id="F16" sourceRef="B_MS_DispatchFailure" targetRef="EndEvent_DispatchFailed" />
    <bpmn:sequenceFlow id="F17" sourceRef="B_C_LetterOverdue" targetRef="N_PC_MonitorDelay" />
  </bpmn:process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_letter">
      <bpmndi:BPMNShape id="Participant_Hospital_di" bpmnElement="Participant_Hospital" isHorizontal="true">
        <dc:Bounds x="100" y="120" width="2032" height="1541" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="1637" width="20" height="61" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Consultants_di" bpmnElement="Lane_Consultants" isHorizontal="true">
        <dc:Bounds x="100" y="150" width="2032" height="382" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="156" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_MedicalSecretaries_di" bpmnElement="Lane_MedicalSecretaries" isHorizontal="true">

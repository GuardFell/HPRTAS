      <bpmndi:BPMNShape id="Lane_TreatmentBookings_di" bpmnElement="Lane_TreatmentBookings" isHorizontal="true">
        <dc:Bounds x="100" y="1966" width="4882" height="305" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="1972" width="152" height="20" />

{
  "id": "clinical-error-review",
  "components": [
    {
      "type": "group",
      "label": "Clinical Error Review",
      "components": [
        {
          "type": "textfield",
          "key": "consultationId",
          "label": "Consultation ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "textarea",
          "key": "clinicalErrorDescription",
          "label": "What the Suspected Error Was",
          "validate": {
            "required": true,
            "maxLength": 2000,
            "minLength": 5
          }
        },
        {
          "type": "textarea",
          "key": "correctionMade",
          "label": "Correction Made",
          "validate": {
            "required": true,
            "maxLength": 2000
          }
        },
        {
          "type": "checkbox",
          "key": "letterCorrected",
          "label": "Letter Corrected and Ready to Approve Again",
          "validate": {
            "required": true
          }
        },
        {
          "type": "datetime",
          "subtype": "date",
          "dateLabel": "Date",
          "key": "reviewDate",
          "label": "Review Date",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textfield",
          "key": "reviewedBy",
          "label": "Reviewed By",
          "description": "The responsible Consultant.",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textarea",
          "key": "reviewNotes",
          "label": "Notes",
          "validate": {
            "maxLength": 2000
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

          <dc:Bounds x="1704" y="812" width="109" height="21" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_MS_ConfirmRecipients_di" bpmnElement="N_MS_ConfirmRecipients">
        <dc:Bounds x="1380" y="740" width="150" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1372" y="824" width="165" height="21" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_MS_ErrorDecision_di" bpmnElement="N_MS_ErrorDecision" isMarkerVisible="true">

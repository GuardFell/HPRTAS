{
  "id": "referral-exception-review",
  "components": [
    {
      "type": "group",
      "label": "Exception",
      "components": [
        {
          "type": "textfield",
          "key": "referralId",
          "label": "Referral ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "textarea",
          "key": "exceptionReason",
          "label": "Why the Referral Was Incomplete",
          "description": "The referral was recorded as incomplete but named no missing items, so nothing could be requested.",
          "validate": {
            "required": true,
            "maxLength": 2000,
            "minLength": 5
          }
        },
        {
          "type": "textarea",
          "key": "missingItems",
          "label": "Missing Items Now Identified",
          "description": "One item per line. These are recorded so the referral can be re-checked and the items requested.",
          "validate": {
            "required": true,
            "maxLength": 2000
          }
        },
        {
          "type": "textfield",
          "key": "reviewedBy",
          "label": "Reviewed By",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textarea",
          "key": "reviewNotes",
          "label": "Notes",
          "validate": {
            "maxLength": 2000
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

          <dc:Bounds x="1052" y="824" width="186" height="21" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_MS_HandleDispatchFailure_di" bpmnElement="N_MS_HandleDispatchFailure">
        <dc:Bounds x="2010" y="790" width="150" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1999" y="874" width="173" height="21" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_MS_LetterDistributed_di" bpmnElement="N_MS_LetterDistributed">
        <dc:Bounds x="2070" y="700" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2025" y="740" width="127" height="21" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_MS_ProcessLetter_di" bpmnElement="N_MS_ProcessLetter">
        <dc:Bounds x="810" y="740" width="150" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="799" y="824" width="172" height="41" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_MS_SendLetter_di" bpmnElement="N_MS_SendLetter">
        <dc:Bounds x="1680" y="730" width="150" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1690" y="839" width="130" height="41" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_PC_IssueReminder_di" bpmnElement="N_PC_IssueReminder">
        <dc:Bounds x="1380" y="1320" width="150" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1370" y="1404" width="169" height="41" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_PC_LetterOnTrack_di" bpmnElement="N_PC_LetterOnTrack">
        <dc:Bounds x="1440" y="1210" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1371" y="1250" width="175" height="41" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_PC_MonitorCorrespondence_di" bpmnElement="N_PC_MonitorCorrespondence">
        <dc:Bounds x="810" y="1280" width="150" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="810" y="1364" width="149" height="41" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_PC_OverdueDuration_di" bpmnElement="N_PC_OverdueDuration" isMarkerVisible="true">
        <dc:Bounds x="1730" y="1290" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1682" y="1344" width="145" height="41" />
        </bpmndi:BPMNLabel>

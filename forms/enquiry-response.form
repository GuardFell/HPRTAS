{
  "id": "enquiry-response",
  "components": [
    {
      "type": "group",
      "label": "Response",
      "components": [
        {
          "type": "textfield",
          "key": "enquiryReference",
          "label": "Enquiry Reference",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "textarea",
          "key": "responseProvided",
          "label": "Response Provided",
          "validate": {
            "required": true,
            "maxLength": 2000
          }
        },
        {
          "type": "datetime",
          "subtype": "date",
          "dateLabel": "Date",
          "key": "responseDate",
          "label": "Date Answered",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textfield",
          "key": "respondedBy",
          "label": "Answered By",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textfield",
          "key": "responsibleTeam",
          "label": "Responsible Team",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "select",
          "key": "enquiryResolved",
          "label": "Is the Enquiry Resolved?",
          "description": "Whether the enquiry is resolved. An enquiry that is not resolved stays open rather than being closed unanswered.",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ]
        },
        {
          "type": "textarea",
          "key": "responseNotes",
          "label": "Notes",
          "description": "Where the enquiry is not resolved it stays open rather than being closed unanswered.",
          "validate": {
            "maxLength": 2000
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

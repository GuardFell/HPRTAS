{
  "id": "clinic-letter",
  "components": [
    {
      "type": "group",
      "label": "Clinic Letter Details",
      "components": [
        {
          "type": "textfield",
          "key": "consultationId",
          "label": "Consultation ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "textarea",
          "key": "letterContent",
          "label": "Clinic Letter Content",
          "validate": {
            "required": true,
            "maxLength": 2000
          }
        },
        {
          "type": "textarea",
          "key": "diagnosis",
          "label": "Diagnosis",
          "validate": {
            "maxLength": 2000
          }
        },
        {
          "type": "textarea",
          "key": "treatmentDecisions",
          "label": "Treatment Decisions",
          "validate": {
            "maxLength": 2000
          }
        },
        {
          "type": "textarea",
          "key": "followUpArrangements",
          "label": "Follow-up Arrangements",
          "validate": {
            "maxLength": 2000
          }
        },
        {
          "type": "textfield",
          "key": "authoringClinician",
          "label": "Authoring Clinician",
          "description": "The Consultant who wrote the clinical content.",
          "validate": {
            "required": true
          }
        }
      ]
    },
    {
      "type": "group",
      "label": "Recipients",
      "components": [
        {
          "type": "textarea",
          "key": "recipients",
          "label": "Recipients (separate with commas)",
          "validate": {
            "required": true,
            "maxLength": 2000
          }
        },
        {
          "type": "select",
          "key": "documentType",
          "label": "Document Type",
          "description": "Passed to the correspondence service with the recipients.",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "New Patient Clinic Letter",
              "value": "new_patient_clinic_letter"
            },
            {
              "label": "Follow-up Clinic Letter",
              "value": "follow_up_clinic_letter"
            },
            {
              "label": "Appointment Letter",
              "value": "appointment_letter"
            },
            {
              "label": "Referral Outcome Letter",
              "value": "referral_outcome_letter"
            },
            {
              "label": "Deferral or Cancellation Letter",
              "value": "deferral_or_cancellation_letter"
            }
          ]
        },
        {
          "type": "select",
          "key": "channelPreference",
          "label": "Channel Preference",
          "values": [
            {
              "label": "Post",
              "value": "post"
            },
            {
              "label": "Digital",
              "value": "digital"
            },
            {
              "label": "Authorised Representative",
              "value": "authorised_representative"
            },
            {
              "label": "Accessible Format",
              "value": "accessible_format"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

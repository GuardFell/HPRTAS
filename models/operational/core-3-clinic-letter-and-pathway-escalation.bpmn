<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_core-3-clinic-letter-and-pathway-escalation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <!-- Core business process 3 of 4. After every consultation the Consultant prepares and approves the clinic letter, the Medical Secretaries perform the administrative checks and distribute it, and the Patient Pathway Coordinators monitor the seven-day target. Includes the escalation chain of the case study: a weekly reminder, escalation to the Administrative Manager after one month and to higher management after three months, and the return of a suspected clinical error to the Consultant. Job type: send-correspondence. -->
  <bpmn:error id="Error_INVALID_VARIABLE" name="INVALID_VARIABLE" errorCode="INVALID_VARIABLE" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hospital" name="Hospital Trust" processRef="core-3-clinic-letter-and-pathway-escalation" />
    <bpmn:participant id="Participant_Correspondence" name="External correspondence service" />
    <bpmn:participant id="Participant_Patient" name="Patient or authorised representative" />
    <bpmn:participant id="Participant_Referring" name="Referring GP or another hospital" />
    <bpmn:messageFlow id="MessageFlow_M1" name="clinic letter to recipients" sourceRef="N_MS_SendLetter" targetRef="Participant_Correspondence" />
    <bpmn:messageFlow id="MessageFlow_M2" name="clinic letter to patient" sourceRef="N_MS_SendLetter" targetRef="Participant_Patient" />
    <bpmn:messageFlow id="MessageFlow_M3" name="clinic letter to GP" sourceRef="N_MS_SendLetter" targetRef="Participant_Referring" />
  </bpmn:collaboration>
  <bpmn:process id="core-3-clinic-letter-and-pathway-escalation" name="Core 3 - Clinic letter approval, distribution and escalation of delays" isExecutable="true">
    <bpmn:documentation>Covers FR-036 to FR-040 and BR-26 to BR-33, EX-17, EX-18: the Consultant owns and approves the clinical content, administrative staff may correct formatting but not clinical meaning, letters are delayed beyond seven days and enter pathway monitoring, reminders stop once the letter is complete and the history is retained. send-correspondence uses the job type and the variable contract of workers/README.md and carries a catch event for INVALID_VARIABLE, which the first edition left as an incident (AS-13: the seven-day target and the escalation thresholds are calendar periods from the appointment date).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Consultants" name="Consultants">
        <bpmn:flowNodeRef>N_C_ConsultationDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_PrepareLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_ApproveLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_ReviewClinicalError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_C_LetterOverdue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MedicalSecretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>N_MS_ProcessLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_ErrorDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_ConfirmRecipients</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_SendLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_LetterDistributed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_HandleDispatchFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_MS_DispatchFailure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PathwayCoordinators" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>N_PC_MonitorCorrespondence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_SevenDays</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_LetterOnTrack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_IssueReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_OverdueDuration</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminManagement" name="Administrative Management Team">
        <bpmn:flowNodeRef>N_AM_ContactConsultant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_AM_EscalateHigher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_AM_Escalated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
  <bpmn:startEvent id="N_C_ConsultationDone" name="Consultation or treatment review completed">
    <bpmn:documentation>Triggers letter production; the New Patient Clinic Letter is the first such letter (FR-036).</bpmn:documentation>
  </bpmn:startEvent>
  <bpmn:userTask id="N_C_PrepareLetter" name="Prepare the clinic letter">
    <bpmn:documentation>Clinical content: consultation, diagnosis, findings, decisions, follow-up arrangements; the Consultant identifies the intended recipients (BR-26, FR-036).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="clinic-letter" />
      <zeebe:assignmentDefinition candidateGroups="consultants" />
    </bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:userTask id="N_C_ApproveLetter" name="Approve the clinical content">
    <bpmn:documentation>Approval gate before distribution; the approval date is recorded (BR-26, BR-29, FR-036). The seven-day timer fires from here (BR-28, BR-30).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="clinic-letter" />
      <zeebe:assignmentDefinition candidateGroups="consultants" />
    </bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:userTask id="N_C_ReviewClinicalError" name="Review suspected clinical error">
    <bpmn:documentation>EX-18, BR-27: a suspected clinical error is returned to the Consultant; administrative staff may not change clinical meaning (FR-037).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="clinical-error-review" />
      <zeebe:assignmentDefinition candidateGroups="consultants" />
    </bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:boundaryEvent id="B_C_LetterOverdue" name="seven days elapsed" attachedToRef="N_C_ApproveLetter">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
  </bpmn:boundaryEvent>
  <bpmn:userTask id="N_MS_ProcessLetter" name="Process and check the letter">
    <bpmn:documentation>Administrative checks and the correspondence timeline: appointment date, start and completion dates, approval date, processing date (BR-27, BR-29, FR-037, FR-039).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="letter-processing" />
      <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
    </bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:exclusiveGateway id="N_MS_ErrorDecision" name="Suspected clinical error?" default="F6">
    <bpmn:documentation>EX-18: return to the Consultant or continue (BR-27, FR-037).</bpmn:documentation>
  </bpmn:exclusiveGateway>
  <bpmn:userTask id="N_MS_ConfirmRecipients" name="Confirm the recipients">
    <bpmn:documentation>Supplies the send-correspondence inputs recipients, documentType and channelPreference, using the recorded communication preference (BR-26, FR-039, FR-051, NFR-011).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="clinic-letter" />
      <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
    </bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:serviceTask id="N_MS_SendLetter" name="Send the letter to recipients">
    <bpmn:documentation>Job type send-correspondence (worker correspondence-dispatch; simulates the external correspondence service). Input: recipients, documentType, channelPreference. Output: dispatchDate, dispatchChannel, dispatchReference. Error: INVALID_VARIABLE (FR-039, NFR-011).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:taskDefinition type="send-correspondence" retries="3" />
    </bpmn:extensionElements>
  </bpmn:serviceTask>
  <bpmn:endEvent id="N_MS_LetterDistributed" name="Letter distributed">
    <bpmn:documentation>Recipients normally receive the correspondence within about two weeks of the appointment (BR-28, FR-039).</bpmn:documentation>
  </bpmn:endEvent>
  <bpmn:userTask id="N_MS_HandleDispatchFailure" name="Handle dispatch failure">
    <bpmn:documentation>Handles INVALID_VARIABLE on send-correspondence: the dispatch variables (for example the recipient list) were unusable, so they are corrected and the letter is sent again through the correspondence service. The failure and the retry are recorded (FR-037, FR-039, NFR-008).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="dispatch-failure" />
      <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
    </bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:boundaryEvent id="B_MS_DispatchFailure" name="dispatch failed" attachedToRef="N_MS_SendLetter">
      <bpmn:errorEventDefinition errorRef="Error_INVALID_VARIABLE" />
  </bpmn:boundaryEvent>
  <bpmn:userTask id="N_PC_MonitorCorrespondence" name="Monitor outstanding letters">
    <bpmn:documentation>Pathway monitoring of outstanding correspondence; seven days after the appointment a letter is delayed (BR-28, BR-30, FR-038).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="correspondence-monitoring" />
      <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
    </bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:exclusiveGateway id="N_PC_SevenDays" name="Letter within seven days?" default="F15">
    <bpmn:documentation>On time / delayed (BR-28, BR-30, EX-17, FR-038).</bpmn:documentation>
  </bpmn:exclusiveGateway>
  <bpmn:endEvent id="N_PC_LetterOnTrack" name="Letter completed within target" />
  <bpmn:userTask id="N_PC_IssueReminder" name="Issue weekly reminder to consultant">
    <bpmn:documentation>Weekly reminders, suppressed once the letter is completed; the full history of reminders, responses and valid reasons for delay is retained (BR-31, BR-33, FR-040, FR-052).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="consultant-reminder" />
      <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
    </bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:exclusiveGateway id="N_PC_OverdueDuration" name="How overdue is the letter?" default="F17">
    <bpmn:documentation>Escalation thresholds as calendar periods from the appointment date (BR-32, AS-13, FR-040).</bpmn:documentation>
  </bpmn:exclusiveGateway>
  <bpmn:userTask id="N_AM_ContactConsultant" name="Contact the responsible consultant">
    <bpmn:documentation>More than one month outstanding: the Administrative Manager contacts the consultant (BR-32, EX-17, FR-040).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="consultant-contact" />
      <zeebe:assignmentDefinition candidateGroups="administrative-management" />
    </bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:userTask id="N_AM_EscalateHigher" name="Escalate to higher management">
    <bpmn:documentation>More than three months outstanding: escalation to the appropriate higher management team; the team is not named in the case (AM-05, BR-32, FR-040).</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:userTask />
      <zeebe:formDefinition formId="management-escalation" />
      <zeebe:assignmentDefinition candidateGroups="administrative-management" />
    </bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:endEvent id="N_AM_Escalated" name="Delay escalated" />
  <bpmn:sequenceFlow id="F1" sourceRef="N_C_ConsultationDone" targetRef="N_C_PrepareLetter" />
  <bpmn:sequenceFlow id="F2" sourceRef="N_C_PrepareLetter" targetRef="N_C_ApproveLetter" />
  <bpmn:sequenceFlow id="F3" sourceRef="B_C_LetterOverdue" targetRef="N_PC_MonitorCorrespondence" />
  <bpmn:sequenceFlow id="F4" sourceRef="N_C_ApproveLetter" targetRef="N_MS_ProcessLetter" />
  <bpmn:sequenceFlow id="F5" sourceRef="N_MS_ProcessLetter" targetRef="N_MS_ErrorDecision" />
  <bpmn:sequenceFlow id="F6" name="clinical error suspected" sourceRef="N_MS_ErrorDecision" targetRef="N_C_ReviewClinicalError" />
  <bpmn:sequenceFlow id="F7" sourceRef="N_C_ReviewClinicalError" targetRef="N_C_ApproveLetter" />
  <bpmn:sequenceFlow id="F8" name="no clinical error" sourceRef="N_MS_ErrorDecision" targetRef="N_MS_ConfirmRecipients">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suspectedClinicalError = false</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F9" sourceRef="N_MS_ConfirmRecipients" targetRef="N_MS_SendLetter" />
  <bpmn:sequenceFlow id="F10" sourceRef="N_MS_SendLetter" targetRef="N_MS_LetterDistributed" />
  <bpmn:sequenceFlow id="F11" sourceRef="B_MS_DispatchFailure" targetRef="N_MS_HandleDispatchFailure" />
  <bpmn:sequenceFlow id="F12" sourceRef="N_MS_HandleDispatchFailure" targetRef="N_MS_ConfirmRecipients" />
  <bpmn:sequenceFlow id="F13" sourceRef="N_PC_MonitorCorrespondence" targetRef="N_PC_SevenDays" />
  <bpmn:sequenceFlow id="F14" name="within seven days" sourceRef="N_PC_SevenDays" targetRef="N_PC_LetterOnTrack">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterWithinSevenDays = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F15" name="delayed" sourceRef="N_PC_SevenDays" targetRef="N_PC_IssueReminder" />
  <bpmn:sequenceFlow id="F16" sourceRef="N_PC_IssueReminder" targetRef="N_PC_OverdueDuration" />
  <bpmn:sequenceFlow id="F17" name="less than one month" sourceRef="N_PC_OverdueDuration" targetRef="N_PC_MonitorCorrespondence" />
  <bpmn:sequenceFlow id="F18" name="one to three months" sourceRef="N_PC_OverdueDuration" targetRef="N_AM_ContactConsultant">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= overdueDuration = &quot;one_to_three_months&quot;</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F19" name="over three months" sourceRef="N_PC_OverdueDuration" targetRef="N_AM_EscalateHigher">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= overdueDuration = &quot;over_three_months&quot;</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F20" sourceRef="N_AM_ContactConsultant" targetRef="N_AM_EscalateHigher" />
  <bpmn:sequenceFlow id="F21" sourceRef="N_AM_EscalateHigher" targetRef="N_AM_Escalated" />
  </bpmn:process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Hospital_di" bpmnElement="Participant_Hospital" isHorizontal="true">
        <dc:Bounds x="100" y="120" width="2634" height="1863" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="1959" width="20" height="105" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Consultants_di" bpmnElement="Lane_Consultants" isHorizontal="true">
        <dc:Bounds x="100" y="150" width="2634" height="383" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="156" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_MedicalSecretaries_di" bpmnElement="Lane_MedicalSecretaries" isHorizontal="true">
        <dc:Bounds x="100" y="533" width="2634" height="530" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="539" width="149" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PathwayCoordinators_di" bpmnElement="Lane_PathwayCoordinators" isHorizontal="true">
        <dc:Bounds x="100" y="1063" width="2634" height="545" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="1069" width="225" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AdminManagement_di" bpmnElement="Lane_AdminManagement" isHorizontal="true">
        <dc:Bounds x="100" y="1608" width="2634" height="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="1614" width="240" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Correspondence_di" bpmnElement="Participant_Correspondence" isHorizontal="true">
        <dc:Bounds x="2884" y="740" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Patient_di" bpmnElement="Participant_Patient" isHorizontal="true">
        <dc:Bounds x="2884" y="780" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Referring_di" bpmnElement="Participant_Referring" isHorizontal="true">
        <dc:Bounds x="2884" y="820" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_C_LetterOverdue_di" bpmnElement="B_C_LetterOverdue">
        <dc:Bounds x="590" y="340" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="533" y="362" width="150" height="21" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_C_ApproveLetter_di" bpmnElement="N_C_ApproveLetter">
        <dc:Bounds x="530" y="280" width="150" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="531" y="389" width="147" height="41" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_C_ConsultationDone_di" bpmnElement="N_C_ConsultationDone">
        <dc:Bounds x="130" y="310" width="36" height="36" />

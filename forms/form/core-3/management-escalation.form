{
  "id": "management-escalation",
  "components": [
    {
      "type": "group",
      "label": "Escalation",
      "components": [
        {
          "type": "textfield",
          "key": "consultationId",
          "label": "Consultation ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "textfield",
          "key": "escalatedTo",
          "label": "Escalated To",
          "description": "The higher management team the delay is escalated to. The case does not name one, so the team chosen is recorded here.",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "datetime",
          "subtype": "date",
          "dateLabel": "Date",
          "key": "escalationDate",
          "label": "Escalation Date",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textarea",
          "key": "escalationReason",
          "label": "Reason for the Escalation",
          "validate": {
            "required": true,
            "maxLength": 2000,
            "minLength": 5
          }
        },
        {
          "type": "textfield",
          "key": "escalatedBy",
          "label": "Escalated By",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textarea",
          "key": "escalationNotes",
          "label": "Notes",
          "validate": {
            "maxLength": 2000
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

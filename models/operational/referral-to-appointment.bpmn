<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_referral-to-appointment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <!-- Core process 1 of 3. Referral receipt and document check, clinical decision, appointment
     booking with the external scheduling service, the two-week telephone rule, unsuccessful
     contact attempts and the no-suitable-appointment path. Job types: validate-referral,
     check-appointment-availability, send-correspondence. -->
  <bpmn:error id="Error_InvalidVariable" name="INVALID_VARIABLE" errorCode="INVALID_VARIABLE" />
  <bpmn:error id="Error_MissingInformation" name="MISSING_INFORMATION_NOT_SPECIFIED" errorCode="MISSING_INFORMATION_NOT_SPECIFIED" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hospital" name="Hospital Trust (specialist service)" processRef="referral-to-appointment" />
    <bpmn:participant id="Participant_ReferringOrganisation" name="Referring GP or another hospital" />
    <bpmn:participant id="Participant_SchedulingService" name="External scheduling service" />
    <bpmn:participant id="Participant_CorrespondenceService" name="External correspondence service" />
    <bpmn:messageFlow id="MessageFlow_A1" name="referral letter and supporting documents" sourceRef="Participant_ReferringOrganisation" targetRef="StartEvent_ReferralReceived" />
    <bpmn:messageFlow id="MessageFlow_A2" name="request for missing information" sourceRef="UserTask_RequestMissingInformation" targetRef="Participant_ReferringOrganisation" />
    <bpmn:messageFlow id="MessageFlow_A3" name="availability request and response" sourceRef="ServiceTask_CheckAppointmentAvailability" targetRef="Participant_SchedulingService" />
    <bpmn:messageFlow id="MessageFlow_A4" name="appointment letter or digital notification" sourceRef="ServiceTask_SendAppointmentNotification" targetRef="Participant_CorrespondenceService" />
  </bpmn:collaboration>
  <bpmn:process id="referral-to-appointment" name="Referral receipt, clinical review and new patient appointment" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Secretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>StartEvent_ReferralReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CheckReferralDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ValidateReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReviewReferralException</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RequestMissingInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error_Validation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consultants" name="Consultants">
        <bpmn:flowNodeRef>UserTask_ClinicalReviewReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClinicalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReferralRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReferralRedirected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OutpatientBookings" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>UserTask_PrepareBookingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckAppointmentAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CorrectBookingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SlotWithinWindow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordNoSuitableSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UrgentReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SendAppointmentNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WithinTwoWeeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TelephoneContactPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ContactOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordUnsuccessfulAttempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AppointmentArranged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error_BookingRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PathwayCoordinators" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>UserTask_ReviewPathwayDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReferredToPathwayTeam</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ReferralReceived" name="Referral received from a GP or another hospital" />
    <bpmn:userTask id="UserTask_CheckReferralDocuments" name="Check the referral and its supporting information">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_ValidateReferral" name="Validate the referral against the expected supporting information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-referral" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DocumentsComplete" name="Documents complete?" />
    <bpmn:userTask id="UserTask_ReviewReferralException" name="Review the validation exception and correct the referral record">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_RequestMissingInformation" name="Request the missing information from the referring organisation">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_ClinicalReviewReferral" name="Clinically review the referral and record the decision and the decision maker">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ClinicalDecision" name="Clinical decision?" />
    <bpmn:endEvent id="EndEvent_ReferralRejected" name="Referral rejected with the reason recorded" />
    <bpmn:endEvent id="EndEvent_ReferralRedirected" name="Referral redirected to another specialist service" />
    <bpmn:userTask id="UserTask_PrepareBookingRequest" name="Record the speciality, priority, preferred timeframe and patient requirements">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_CheckAppointmentAvailability" name="Request appointment availability from the external scheduling service">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-appointment-availability" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_CorrectBookingRequest" name="Correct the booking request and retry the availability check">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SlotWithinWindow" name="Slot within the requested period?" />
    <bpmn:userTask id="UserTask_RecordNoSuitableSlot" name="Record that no suitable appointment was found and refer the case to the pathway team">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_UrgentReferral" name="Urgent referral?" />
    <bpmn:serviceTask id="ServiceTask_SendAppointmentNotification" name="Send the appointment notification through the correspondence service">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-correspondence" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_WithinTwoWeeks" name="Appointment within two weeks?" />
    <bpmn:userTask id="UserTask_TelephoneContactPatient" name="Telephone the patient and record the contact attempt and its outcome">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ContactOutcome" name="Contact outcome?" />
    <bpmn:userTask id="UserTask_RecordUnsuccessfulAttempt" name="Record the unsuccessful attempt and retry the contact">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_AppointmentArranged" name="New patient appointment arranged and the patient informed" />
    <bpmn:userTask id="UserTask_ReviewPathwayDelay" name="Review the delay and re-plan the appointment with the pathway team">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_ReferredToPathwayTeam" name="Case referred to the pathway team" />
    <bpmn:boundaryEvent id="Boundary_Error_Validation" name="MISSING_INFORMATION_NOT_SPECIFIED" attachedToRef="ServiceTask_ValidateReferral">
      <bpmn:errorEventDefinition errorRef="Error_MissingInformation" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Error_BookingRequest" name="INVALID_VARIABLE" attachedToRef="ServiceTask_CheckAppointmentAvailability">
      <bpmn:errorEventDefinition errorRef="Error_InvalidVariable" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="StartEvent_ReferralReceived" targetRef="UserTask_CheckReferralDocuments" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="UserTask_CheckReferralDocuments" targetRef="ServiceTask_ValidateReferral" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="ServiceTask_ValidateReferral" targetRef="Gateway_DocumentsComplete" />
    <bpmn:sequenceFlow id="Flow_A4" name="complete" sourceRef="Gateway_DocumentsComplete" targetRef="UserTask_ClinicalReviewReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationResult = &quot;complete&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A5" name="incomplete" sourceRef="Gateway_DocumentsComplete" targetRef="UserTask_RequestMissingInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationResult != &quot;complete&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="UserTask_RequestMissingInformation" targetRef="UserTask_CheckReferralDocuments" />
    <bpmn:sequenceFlow id="Flow_A7" sourceRef="Boundary_Error_Validation" targetRef="UserTask_ReviewReferralException" />
    <bpmn:sequenceFlow id="Flow_A8" sourceRef="UserTask_ReviewReferralException" targetRef="UserTask_RequestMissingInformation" />
    <bpmn:sequenceFlow id="Flow_A9" sourceRef="UserTask_ClinicalReviewReferral" targetRef="Gateway_ClinicalDecision" />
    <bpmn:sequenceFlow id="Flow_A10" name="accepted" sourceRef="Gateway_ClinicalDecision" targetRef="UserTask_PrepareBookingRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;accepted&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A11" name="rejected" sourceRef="Gateway_ClinicalDecision" targetRef="EndEvent_ReferralRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;rejected&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A12" name="redirected" sourceRef="Gateway_ClinicalDecision" targetRef="EndEvent_ReferralRedirected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;redirected&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A13" name="further information" sourceRef="Gateway_ClinicalDecision" targetRef="UserTask_RequestMissingInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;further_information&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A14" sourceRef="UserTask_PrepareBookingRequest" targetRef="ServiceTask_CheckAppointmentAvailability" />
    <bpmn:sequenceFlow id="Flow_A15" sourceRef="ServiceTask_CheckAppointmentAvailability" targetRef="Gateway_SlotWithinWindow" />
    <bpmn:sequenceFlow id="Flow_A16" sourceRef="Boundary_Error_BookingRequest" targetRef="UserTask_CorrectBookingRequest" />
    <bpmn:sequenceFlow id="Flow_A17" sourceRef="UserTask_CorrectBookingRequest" targetRef="UserTask_PrepareBookingRequest" />
    <bpmn:sequenceFlow id="Flow_A18" name="available in window" sourceRef="Gateway_SlotWithinWindow" targetRef="ServiceTask_SendAppointmentNotification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable = true and withinRequestedWindow = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A19" name="not available in window" sourceRef="Gateway_SlotWithinWindow" targetRef="UserTask_RecordNoSuitableSlot" />
    <bpmn:sequenceFlow id="Flow_A20" sourceRef="UserTask_RecordNoSuitableSlot" targetRef="Gateway_UrgentReferral" />
    <bpmn:sequenceFlow id="Flow_A21" name="urgent" sourceRef="Gateway_UrgentReferral" targetRef="ServiceTask_CheckAppointmentAvailability">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= priority = &quot;urgent&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A22" name="routine" sourceRef="Gateway_UrgentReferral" targetRef="UserTask_ReviewPathwayDelay" />
    <bpmn:sequenceFlow id="Flow_A23" sourceRef="UserTask_ReviewPathwayDelay" targetRef="EndEvent_ReferredToPathwayTeam" />
    <bpmn:sequenceFlow id="Flow_A24" sourceRef="ServiceTask_SendAppointmentNotification" targetRef="Gateway_WithinTwoWeeks" />
    <bpmn:sequenceFlow id="Flow_A25" name="within two weeks" sourceRef="Gateway_WithinTwoWeeks" targetRef="UserTask_TelephoneContactPatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentWithinTwoWeeks = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A26" name="later" sourceRef="Gateway_WithinTwoWeeks" targetRef="EndEvent_AppointmentArranged" />
    <bpmn:sequenceFlow id="Flow_A27" sourceRef="UserTask_TelephoneContactPatient" targetRef="Gateway_ContactOutcome" />
    <bpmn:sequenceFlow id="Flow_A28" name="contacted" sourceRef="Gateway_ContactOutcome" targetRef="EndEvent_AppointmentArranged">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactOutcome = &quot;contacted&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A29" name="alternative requested" sourceRef="Gateway_ContactOutcome" targetRef="UserTask_PrepareBookingRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactOutcome = &quot;alternative_requested&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A30" name="not contacted" sourceRef="Gateway_ContactOutcome" targetRef="UserTask_RecordUnsuccessfulAttempt" />
    <bpmn:sequenceFlow id="Flow_A31" sourceRef="UserTask_RecordUnsuccessfulAttempt" targetRef="UserTask_TelephoneContactPatient" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Hospital_di" bpmnElement="Participant_Hospital" isHorizontal="true">
        <dc:Bounds x="140" y="140" width="3520" height="570" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="150" y="716" width="200" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Secretaries_di" bpmnElement="Lane_Secretaries" isHorizontal="true">
        <dc:Bounds x="140" y="170" width="3520" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Consultants_di" bpmnElement="Lane_Consultants" isHorizontal="true">
        <dc:Bounds x="140" y="300" width="3520" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OutpatientBookings_di" bpmnElement="Lane_OutpatientBookings" isHorizontal="true">
        <dc:Bounds x="140" y="430" width="3520" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PathwayCoordinators_di" bpmnElement="Lane_PathwayCoordinators" isHorizontal="true">
        <dc:Bounds x="140" y="560" width="3520" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_ReferringOrganisation_di" bpmnElement="Participant_ReferringOrganisation" isHorizontal="true">
        <dc:Bounds x="3860" y="205" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_SchedulingService_di" bpmnElement="Participant_SchedulingService" isHorizontal="true">
        <dc:Bounds x="3860" y="465" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_CorrespondenceService_di" bpmnElement="Participant_CorrespondenceService" isHorizontal="true">
        <dc:Bounds x="3860" y="555" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_ReferralReceived_di" bpmnElement="StartEvent_ReferralReceived">
        <dc:Bounds x="227" y="217" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="76" y="259" width="338" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_CheckReferralDocuments_di" bpmnElement="UserTask_CheckReferralDocuments">
        <dc:Bounds x="345" y="195" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="225" y="281" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ValidateReferral_di" bpmnElement="ServiceTask_ValidateReferral">
        <dc:Bounds x="495" y="195" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="375" y="281" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DocumentsComplete_di" bpmnElement="Gateway_DocumentsComplete" isMarkerVisible="true">
        <dc:Bounds x="670" y="210" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="627" y="182" width="137" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ReviewReferralException_di" bpmnElement="UserTask_ReviewReferralException">
        <dc:Bounds x="795" y="195" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="675" y="281" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_RequestMissingInformation_di" bpmnElement="UserTask_RequestMissingInformation">
        <dc:Bounds x="945" y="195" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="825" y="281" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ClinicalReviewReferral_di" bpmnElement="UserTask_ClinicalReviewReferral">
        <dc:Bounds x="1095" y="325" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="975" y="411" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ClinicalDecision_di" bpmnElement="Gateway_ClinicalDecision" isMarkerVisible="true">
        <dc:Bounds x="1270" y="340" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1230" y="312" width="130" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ReferralRejected_di" bpmnElement="EndEvent_ReferralRejected">
        <dc:Bounds x="1427" y="347" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1294" y="389" width="302" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ReferralRedirected_di" bpmnElement="EndEvent_ReferralRedirected">
        <dc:Bounds x="1577" y="347" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1425" y="389" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_PrepareBookingRequest_di" bpmnElement="UserTask_PrepareBookingRequest">
        <dc:Bounds x="1695" y="455" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1575" y="541" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_CheckAppointmentAvailability_di" bpmnElement="ServiceTask_CheckAppointmentAvailability">
        <dc:Bounds x="1845" y="455" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1725" y="541" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_CorrectBookingRequest_di" bpmnElement="UserTask_CorrectBookingRequest">
        <dc:Bounds x="1995" y="455" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1875" y="541" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SlotWithinWindow_di" bpmnElement="Gateway_SlotWithinWindow" isMarkerVisible="true">
        <dc:Bounds x="2170" y="470" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2076" y="442" width="238" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_RecordNoSuitableSlot_di" bpmnElement="UserTask_RecordNoSuitableSlot">
        <dc:Bounds x="2295" y="455" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2175" y="541" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_UrgentReferral_di" bpmnElement="Gateway_UrgentReferral" isMarkerVisible="true">
        <dc:Bounds x="2470" y="470" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2435" y="442" width="120" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_SendAppointmentNotification_di" bpmnElement="ServiceTask_SendAppointmentNotification">
        <dc:Bounds x="2745" y="455" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2625" y="541" width="340" height="20" />
        </bpmndi:BPMNLabel>

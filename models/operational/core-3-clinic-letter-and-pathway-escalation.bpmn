          <dc:Bounds x="53" y="350" width="191" height="41" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_C_PrepareLetter_di" bpmnElement="N_C_PrepareLetter">
        <dc:Bounds x="280" y="290" width="150" height="80" />

        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="538" width="149" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PathwayCoordinators_di" bpmnElement="Lane_PathwayCoordinators" isHorizontal="true">
        <dc:Bounds x="100" y="945" width="2032" height="361" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="951" width="225" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AdminManagement_di" bpmnElement="Lane_AdminManagement" isHorizontal="true">
        <dc:Bounds x="100" y="1306" width="2032" height="309" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="1312" width="240" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

{
  "id": "consultant-contact",
  "components": [
    {
      "type": "group",
      "label": "Contact with the Consultant",
      "components": [
        {
          "type": "textfield",
          "key": "consultationId",
          "label": "Consultation ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "datetime",
          "subtype": "date",
          "dateLabel": "Date",
          "key": "contactDate",
          "label": "Contact Date",
          "validate": {
            "required": true
          }
        },
        {
          "type": "select",
          "key": "contactOutcome",
          "label": "Outcome of the Contact",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Consultant Responded",
              "value": "responded"
            },
            {
              "label": "Acknowledged",
              "value": "acknowledged"
            },
            {
              "label": "No Response",
              "value": "no_response"
            }
          ]
        },
        {
          "type": "textarea",
          "key": "consultantResponse",
          "label": "What the Consultant Said",
          "validate": {
            "maxLength": 2000
          }
        },
        {
          "type": "textfield",
          "key": "contactedBy",
          "label": "Contacted By",
          "description": "The Administrative Manager.",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textarea",
          "key": "contactNotes",
          "label": "Notes",
          "validate": {
            "maxLength": 2000
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

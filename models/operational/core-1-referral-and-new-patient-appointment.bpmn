<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_core-1-referral-and-new-patient-appointment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:error id="Error_INVALID_VARIABLE" name="INVALID_VARIABLE" errorCode="INVALID_VARIABLE" />
  <bpmn:error id="Error_MISSING_INFORMATION_NOT_SPECIFIED" name="MISSING_INFORMATION_NOT_SPECIFIED" errorCode="MISSING_INFORMATION_NOT_SPECIFIED" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hospital" name="Hospital Trust" processRef="core-1-referral-and-new-patient-appointment" />
    <bpmn:participant id="Participant_Referring" name="Referring GP or another hospital" />
    <bpmn:participant id="Participant_Scheduling" name="External scheduling service" />
    <bpmn:participant id="Participant_Correspondence" name="External correspondence service" />
    <bpmn:participant id="Participant_Patient" name="Patient or authorised representative" />
    <bpmn:messageFlow id="MessageFlow_M1" name="referral and supporting documents" sourceRef="Participant_Referring" targetRef="N_MS_CheckReferral" />
    <bpmn:messageFlow id="MessageFlow_M2" name="missing information request" sourceRef="N_MS_RequestMissing" targetRef="Participant_Referring" />
    <bpmn:messageFlow id="MessageFlow_M3" name="availability request" sourceRef="N_OB_CheckAvailability" targetRef="Participant_Scheduling" />
    <bpmn:messageFlow id="MessageFlow_M4" name="appointment letter" sourceRef="N_OB_SendNotification" targetRef="Participant_Correspondence" />
    <bpmn:messageFlow id="MessageFlow_M5" name="telephone contact" sourceRef="N_OB_TelephonePatient" targetRef="Participant_Patient" />
  </bpmn:collaboration>
  <bpmn:process id="core-1-referral-and-new-patient-appointment" name="Core 1 - Referral receipt, clinical decision and new patient appointment" isExecutable="true">
    <bpmn:documentation>Covers FR-001 to FR-016 and BR-01 to BR-09, EX-01 to EX-09: referral receipt and the document completeness check, the clinical decision with a recorded reason, appointment availability, the two-week telephone rule, contact attempts, urgent referrals and the no-suitable-slot path. Service tasks use the job types and the variable contract of workers/README.md. Every service task carries a catch event for every error code it can raise - validate-referral raises INVALID_VARIABLE and MISSING_INFORMATION_NOT_SPECIFIED, check-appointment-availability and send-correspondence raise INVALID_VARIABLE - and each failure is told apart by which boundary event was taken, because error variables do not survive into the process scope.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PathwayCoordinators" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>N_PC_ReviewDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_Referred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_EscalateUrgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_UrgentEscalated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OutpatientBookings" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>N_OB_PrepareRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_CheckAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_SlotAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_SendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_WithinTwoWeeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_TelephonePatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_ContactOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_RecordAttempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_AppointmentArranged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_RecordNoSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_UrgentReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_CorrectRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_RecordDispatchFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_OB_DispatchFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_OB_BookingInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_MergeBookingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_MergeAvailabilityRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_MergeContactPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_MergeAppointmentArranged</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consultants" name="Consultants">
        <bpmn:flowNodeRef>N_C_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_ReferralDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_Redirected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MedicalSecretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>N_MS_ReferralReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_CheckReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_ValidateReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_DocumentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_RequestMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_ReviewException</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_CorrectReferralInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_MS_InvalidInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_MS_Validation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_MergeReferralArrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_MergeReferralCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_MergeMissingInformation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N_MS_ReferralReceived" name="Referral received">
      <bpmn:documentation>Referral received by message flow from the referring organisation (BR-01, FR-001).</bpmn:documentation>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="N_MS_MergeReferralArrival" name="Referral received or returned">
      <bpmn:documentation>Merges the paths that reach Check referral and documents (Referral received, Request missing information). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. The referral as it arrived and the referral that came back with the missing information reach the same checklist: whichever way it got here, it is checked the same way (BR-01).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_MS_CheckReferral" name="Check referral and documents">
      <bpmn:documentation>Medical Secretaries record the supporting information received and the patient identification check (BR-01, BR-46, FR-002, FR-048), and supply the validate-referral inputs documentsComplete, missingItems and referringOrganisation.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="referral-check" />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_MS_MergeReferralCheck" name="Checked referral or corrected input">
      <bpmn:documentation>Merges the paths that reach Validate referral (Check referral and documents, Correct referral input). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. A referral that passed the check and one whose input was corrected are validated the same way (BR-01, FR-002).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N_MS_ValidateReferral" name="Validate referral">
      <bpmn:documentation>Job type validate-referral (worker referral-validation, no simulated service). Input: documentsComplete, missingItems, referringOrganisation. Output: validationResult, requestedItems, missingInformationRequestedFrom, missingInformationRequestedDate. Errors: INVALID_VARIABLE, MISSING_INFORMATION_NOT_SPECIFIED (BR-01, FR-002, FR-003).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-referral" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N_MS_DocumentsComplete" name="Documents complete?" default="F5">
      <bpmn:documentation>Reads validationResult; error variables do not reach this scope (BR-01, FR-002).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="N_MS_MergeMissingInformation" name="Incomplete, exceptional or queried">
      <bpmn:documentation>Merges the paths that reach Request missing information (Documents complete?, Review referral exception, Referral decision?). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. An incomplete referral, one whose validation refused the input and one the consultant asked about all need the same administrative action: request what is missing (BR-02, EX-01, EX-03).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_MS_RequestMissing" name="Request missing information">
      <bpmn:documentation>Medical Secretaries only; they may not judge clinical suitability (BR-02, EX-01, FR-003).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="missing-information-request" />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_MS_ReviewException" name="Review referral exception">
      <bpmn:documentation>Handles MISSING_INFORMATION_NOT_SPECIFIED: the referral is marked incomplete but names no missing items, so nothing can be requested until the exception is reviewed (FR-003).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="referral-exception-review" />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_MS_CorrectReferralInput" name="Correct referral input">
      <bpmn:documentation>Handles INVALID_VARIABLE on validate-referral: a required variable is missing, of the wrong type or contradicts another value, so the recorded inputs are corrected and the validation is re-run. Keeping this separate from the missing-information path is how the model tells the two failures apart (workers/README.md integration constraint).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="referral-check" />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_C_ClinicalReview" name="Review the referral clinically">
      <bpmn:documentation>Consultant only; the decision, its reason, the decision maker and the date and time are recorded (BR-03, FR-005).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="referral-review" />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_C_ReferralDecision" name="Referral decision?" default="F15">
      <bpmn:documentation>Accepted / rejected / redirected / further information (BR-03, EX-02 to EX-04, FR-005).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="N_C_Rejected" name="Referral rejected">
      <bpmn:documentation>EX-02: recorded with its reason; no appointment may follow (BR-03, BR-04).</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:endEvent id="N_C_Redirected" name="Referral redirected">
      <bpmn:documentation>EX-04: redirected to another specialist service, with the reason recorded.</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="N_OB_MergeBookingRequest" name="Accepted referral or alternative asked for">
      <bpmn:documentation>Merges the paths that reach Prepare booking request (Referral decision?, Contact outcome?). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. An accepted referral and a patient who asked for another date both reach the preparation of a booking request (FR-012, EX-09).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_OB_PrepareRequest" name="Prepare booking request">
      <bpmn:documentation>Required speciality, appointment priority, preferred timeframe and any patient requirements (BR-05, FR-010); a New Patient Appointment may only be arranged after an accepted referral (BR-04, FR-006).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="booking-request" />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_OB_MergeAvailabilityRequest" name="New or corrected request">
      <bpmn:documentation>Merges the paths that reach Check appointment availability (Prepare booking request, Correct booking request). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. The first attempt and an attempt after the request was corrected ask the scheduling service the same question (FR-013, EX-06).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N_OB_CheckAvailability" name="Check appointment availability">
      <bpmn:documentation>Job type check-appointment-availability (worker appointment-availability; simulates the external scheduling service). Input: speciality, priority, requestedWindow. Output: slotAvailable, appointmentDate, alternativeDate, withinRequestedWindow, appointmentWithinTwoWeeks, schedulingServiceOutcome. Error: INVALID_VARIABLE. appointmentWithinTwoWeeks is recomputed by the worker from the slot actually found and drives the two-week telephone rule (BR-06, BR-07, FR-011 to FR-016).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-appointment-availability" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N_OB_SlotAvailable" name="Slot in requested period?" default="F21">
      <bpmn:documentation>Reads slotAvailable and withinRequestedWindow from the worker (FR-016, EX-05).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N_OB_SendNotification" name="Send appointment letter">
      <bpmn:documentation>Job type send-correspondence (worker correspondence-dispatch; simulates the external correspondence service). Input: recipients, documentType, channelPreference. Output: dispatchDate, dispatchChannel, dispatchReference. Error: INVALID_VARIABLE (FR-012, FR-039, NFR-011).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-correspondence" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N_OB_WithinTwoWeeks" name="Within two weeks?" default="F30">
      <bpmn:documentation>Reads appointmentWithinTwoWeeks, recomputed by the worker from the slot actually found (BR-07, FR-014, AS-13).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="N_OB_MergeContactPath" name="Contact paths">
      <bpmn:documentation>Merges the paths that reach Telephone the patient (Within two weeks?, Record dispatch failure, Record and retry contact). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. The two-week telephone rule, a dispatch failure to work around and a further attempt all lead to the patient being telephoned (BR-07, BR-08, EX-07).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_OB_TelephonePatient" name="Telephone the patient">
      <bpmn:documentation>Extra telephone contact inside two weeks; every attempt and its outcome is recorded (BR-07, BR-08, FR-013, FR-014, EX-07 to EX-09).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="patient-contact" />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_OB_ContactOutcome" name="Contact outcome?" default="F34">
      <bpmn:documentation>Contacted / alternative appointment requested / not reached (BR-08, EX-07 to EX-09).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_OB_RecordAttempt" name="Record and retry contact">
      <bpmn:documentation>Unanswered call or incorrect contact number: the attempt and its outcome are recorded and another attempt is made (BR-08, FR-013, EX-07, EX-08).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="patient-contact" />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_OB_MergeAppointmentArranged" name="Appointment arranged">
      <bpmn:documentation>Merges the paths that reach Appointment arranged (Within two weeks?, Contact outcome?). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. An appointment nobody needed to telephone about and one that was telephoned about end the same way (BR-07, FR-014).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="N_OB_AppointmentArranged" name="Appointment arranged" />
    <bpmn:userTask id="N_OB_RecordNoSlot" name="Record no suitable slot">
      <bpmn:documentation>EX-05: no suitable appointment inside the requested period; the scheduling outcome is outside_window or none and the action taken is recorded (FR-016).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="no-suitable-slot" />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_OB_UrgentReferral" name="Urgent referral?" default="F26">
      <bpmn:documentation>Urgent referrals are expedited through the same booking process: the request carries priority = "urgent" so the scheduling service searches with the urgent lead time, and a referral that still finds no slot is escalated to the pathway coordinator immediately rather than re-checked, because the scheduling service answers the same request with the same result (BR-09, AS-06, EX-06, FR-015).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_OB_CorrectRequest" name="Correct booking request">
      <bpmn:documentation>Handles INVALID_VARIABLE on check-appointment-availability: the booking request variables are corrected and the availability check is re-run, without creating a duplicate appointment (FR-016, FR-018).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="booking-request" />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_OB_RecordDispatchFailure" name="Record dispatch failure">
      <bpmn:documentation>Handles INVALID_VARIABLE on send-correspondence: the letter was not dispatched because a required variable (for example the recipient list) was unusable. The failure is recorded and the patient is contacted through another channel, so informing the patient does not depend on the correspondence service (FR-012, NFR-008, NFR-011).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="dispatch-failure" />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_PC_ReviewDelay" name="Review the delay">
      <bpmn:documentation>Pathway monitoring of a case with no suitable appointment (FR-016, FR-040).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="delay-review" />
        <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_PC_EscalateUrgent" name="Escalate the urgent referral">
      <bpmn:documentation>EX-06, BR-09: an urgent referral that cannot be booked inside the requested period cannot wait for normal administrative timescales, so it is taken out of the booking process and escalated at once. Re-checking availability is not an option: the scheduling service is asked once per booking and answers the same request with the same result (FR-015).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="urgent-referral-escalation" />
        <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="N_PC_Referred" name="Referred to pathway team" />
    <bpmn:endEvent id="N_PC_UrgentEscalated" name="Urgent referral escalated">
      <bpmn:documentation>EX-06: the urgent referral has left the booking process and been escalated (FR-015).</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B_OB_DispatchFailure" name="dispatch failed" attachedToRef="N_OB_SendNotification">
      <bpmn:errorEventDefinition errorRef="Error_INVALID_VARIABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_OB_BookingInput" name="invalid booking input" attachedToRef="N_OB_CheckAvailability">
      <bpmn:errorEventDefinition errorRef="Error_INVALID_VARIABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_MS_InvalidInput" name="invalid input" attachedToRef="N_MS_ValidateReferral">
      <bpmn:errorEventDefinition errorRef="Error_INVALID_VARIABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_MS_Validation" name="missing information" attachedToRef="N_MS_ValidateReferral">
      <bpmn:errorEventDefinition errorRef="Error_MISSING_INFORMATION_NOT_SPECIFIED" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="N_MS_ReferralReceived" targetRef="N_MS_MergeReferralArrival" />
    <bpmn:sequenceFlow id="F6" sourceRef="N_MS_RequestMissing" targetRef="N_MS_MergeReferralArrival" />
    <bpmn:sequenceFlow id="F2" sourceRef="N_MS_CheckReferral" targetRef="N_MS_MergeReferralCheck" />
    <bpmn:sequenceFlow id="F9" sourceRef="N_MS_CorrectReferralInput" targetRef="N_MS_MergeReferralCheck" />
    <bpmn:sequenceFlow id="F3" sourceRef="N_MS_ValidateReferral" targetRef="N_MS_DocumentsComplete" />
    <bpmn:sequenceFlow id="F4" name="complete" sourceRef="N_MS_DocumentsComplete" targetRef="N_C_ClinicalReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= validationResult = "complete"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" name="incomplete" sourceRef="N_MS_DocumentsComplete" targetRef="N_MS_MergeMissingInformation" />
    <bpmn:sequenceFlow id="F8" sourceRef="N_MS_ReviewException" targetRef="N_MS_MergeMissingInformation" />
    <bpmn:sequenceFlow id="F15" name="further information" sourceRef="N_C_ReferralDecision" targetRef="N_MS_MergeMissingInformation" />
    <bpmn:sequenceFlow id="F7" sourceRef="B_MS_Validation" targetRef="N_MS_ReviewException" />
    <bpmn:sequenceFlow id="F10" sourceRef="B_MS_InvalidInput" targetRef="N_MS_CorrectReferralInput" />
    <bpmn:sequenceFlow id="F11" sourceRef="N_C_ClinicalReview" targetRef="N_C_ReferralDecision" />
    <bpmn:sequenceFlow id="F12" name="accepted" sourceRef="N_C_ReferralDecision" targetRef="N_OB_MergeBookingRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = "accepted"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" name="rejected" sourceRef="N_C_ReferralDecision" targetRef="N_C_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = "rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" name="redirected" sourceRef="N_C_ReferralDecision" targetRef="N_C_Redirected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = "redirected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F33" name="another date" sourceRef="N_OB_ContactOutcome" targetRef="N_OB_MergeBookingRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactOutcome = "alternative_requested"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" sourceRef="N_OB_PrepareRequest" targetRef="N_OB_MergeAvailabilityRequest" />
    <bpmn:sequenceFlow id="F19" sourceRef="N_OB_CorrectRequest" targetRef="N_OB_MergeAvailabilityRequest" />
    <bpmn:sequenceFlow id="F25" name="urgent" sourceRef="N_OB_UrgentReferral" targetRef="N_PC_EscalateUrgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= priority = "urgent"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" sourceRef="N_OB_CheckAvailability" targetRef="N_OB_SlotAvailable" />
    <bpmn:sequenceFlow id="F20" name="in window" sourceRef="N_OB_SlotAvailable" targetRef="N_OB_SendNotification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable = true and withinRequestedWindow = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F21" name="outside window" sourceRef="N_OB_SlotAvailable" targetRef="N_OB_RecordNoSlot" />
    <bpmn:sequenceFlow id="F28" sourceRef="N_OB_SendNotification" targetRef="N_OB_WithinTwoWeeks" />
    <bpmn:sequenceFlow id="F29" name="within two weeks" sourceRef="N_OB_WithinTwoWeeks" targetRef="N_OB_MergeContactPath">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentWithinTwoWeeks = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F30" name="later" sourceRef="N_OB_WithinTwoWeeks" targetRef="N_OB_MergeAppointmentArranged" />
    <bpmn:sequenceFlow id="F23" sourceRef="N_OB_RecordDispatchFailure" targetRef="N_OB_MergeContactPath" />
    <bpmn:sequenceFlow id="F35" sourceRef="N_OB_RecordAttempt" targetRef="N_OB_MergeContactPath" />
    <bpmn:sequenceFlow id="F31" sourceRef="N_OB_TelephonePatient" targetRef="N_OB_ContactOutcome" />
    <bpmn:sequenceFlow id="F32" name="contacted" sourceRef="N_OB_ContactOutcome" targetRef="N_OB_MergeAppointmentArranged">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactOutcome = "contacted"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F34" name="no contact" sourceRef="N_OB_ContactOutcome" targetRef="N_OB_RecordAttempt" />
    <bpmn:sequenceFlow id="F24" sourceRef="N_OB_RecordNoSlot" targetRef="N_OB_UrgentReferral" />
    <bpmn:sequenceFlow id="F26" name="routine" sourceRef="N_OB_UrgentReferral" targetRef="N_PC_ReviewDelay" />
    <bpmn:sequenceFlow id="F18" sourceRef="B_OB_BookingInput" targetRef="N_OB_CorrectRequest" />
    <bpmn:sequenceFlow id="F22" sourceRef="B_OB_DispatchFailure" targetRef="N_OB_RecordDispatchFailure" />
    <bpmn:sequenceFlow id="F27" sourceRef="N_PC_ReviewDelay" targetRef="N_PC_Referred" />
    <bpmn:sequenceFlow id="F36" sourceRef="N_PC_EscalateUrgent" targetRef="N_PC_UrgentEscalated" />
      <bpmn:sequenceFlow id="MF1" sourceRef="N_MS_MergeReferralArrival" targetRef="N_MS_CheckReferral" />
    <bpmn:sequenceFlow id="MF2" sourceRef="N_MS_MergeReferralCheck" targetRef="N_MS_ValidateReferral" />
    <bpmn:sequenceFlow id="MF3" sourceRef="N_MS_MergeMissingInformation" targetRef="N_MS_RequestMissing" />
    <bpmn:sequenceFlow id="MF4" sourceRef="N_OB_MergeBookingRequest" targetRef="N_OB_PrepareRequest" />
    <bpmn:sequenceFlow id="MF5" sourceRef="N_OB_MergeAvailabilityRequest" targetRef="N_OB_CheckAvailability" />
    <bpmn:sequenceFlow id="MF6" sourceRef="N_OB_MergeContactPath" targetRef="N_OB_TelephonePatient" />
    <bpmn:sequenceFlow id="MF7" sourceRef="N_OB_MergeAppointmentArranged" targetRef="N_OB_AppointmentArranged" />
</bpmn:process>

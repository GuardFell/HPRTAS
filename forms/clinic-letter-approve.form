{
  "id": "clinic-letter-approve",
  "components": [
    {
      "type": "group",
      "label": "Approval",
      "components": [
        {
          "type": "textfield",
          "key": "consultationId",
          "label": "Consultation ID",
          "validate": {
            "required": true
          }
        },
        {
          "type": "checkbox",
          "key": "clinicalContentApproved",
          "label": "Clinical Content Approved",
          "description": "Approval is what releases the letter for distribution: it goes to the Medical Secretaries for the administrative check once it is approved. Left unticked the letter stays with the Consultant and is not distributed.",
          "validate": {
            "required": true
          }
        },
        {
          "type": "datetime",
          "subtype": "date",
          "dateLabel": "Date",
          "key": "approvalDate",
          "label": "Letter Approval Date",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textfield",
          "key": "approvedBy",
          "label": "Approved By",
          "description": "The Consultant who approves the clinical content.",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textarea",
          "key": "approvalNotes",
          "label": "Notes"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

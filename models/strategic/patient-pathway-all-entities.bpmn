<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_patient-pathway-all-entities" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <!-- Strategic (non-executable) view of the case study. Every internal entity of the case study has its own lane and every external organisation has its own black-box pool, so the division of responsibility and every point of external dependency are visible in one model. Executable detail is in models/operational/core-1..4. -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hospital" name="Hospital Trust" processRef="patient-pathway-all-entities" />
    <bpmn:participant id="Participant_Referring" name="Referring GP or another hospital" />
    <bpmn:participant id="Participant_Patient" name="Patient or authorised representative" />
    <bpmn:participant id="Participant_Scheduling" name="External scheduling service" />
    <bpmn:participant id="Participant_Correspondence" name="External correspondence service" />
    <bpmn:participant id="Participant_TreatmentService" name="External treatment, laboratory and imaging service" />
    <bpmn:participant id="Participant_PaymentProvider" name="External Payment Service Provider" />
    <bpmn:participant id="Participant_FundingOrganisation" name="Approved insurer or funding organisation" />
    <bpmn:messageFlow id="MessageFlow_S1" name="referral and documents" sourceRef="Participant_Referring" targetRef="N_MS_CheckReferral" />
    <bpmn:messageFlow id="MessageFlow_S2" name="missing information" sourceRef="N_MS_RequestMissing" targetRef="Participant_Referring" />
    <bpmn:messageFlow id="MessageFlow_S3" name="availability request" sourceRef="N_OB_ArrangeNewPatient" targetRef="Participant_Scheduling" />
    <bpmn:messageFlow id="MessageFlow_S4" name="appointment letter" sourceRef="N_OB_ConfirmAndInform" targetRef="Participant_Correspondence" />
    <bpmn:messageFlow id="MessageFlow_S5" name="telephone contact" sourceRef="N_OB_TelephonePatient" targetRef="Participant_Patient" />
    <bpmn:messageFlow id="MessageFlow_S6" name="treatment request" sourceRef="N_TB_CoordinateTreatment" targetRef="Participant_TreatmentService" />
    <bpmn:messageFlow id="MessageFlow_S7" name="funding approval request" sourceRef="N_F_RecordApproval" targetRef="Participant_FundingOrganisation" />
    <bpmn:messageFlow id="MessageFlow_S8" name="payment request" sourceRef="N_F_ProcessPayment" targetRef="Participant_PaymentProvider" />
    <bpmn:messageFlow id="MessageFlow_S9" name="refund request" sourceRef="N_F_ProcessRefund" targetRef="Participant_PaymentProvider" />
    <bpmn:messageFlow id="MessageFlow_S10" name="clinic letter" sourceRef="N_MS_ProcessLetter" targetRef="Participant_Correspondence" />
    <bpmn:messageFlow id="MessageFlow_S11" name="clinic letter to GP" sourceRef="N_MS_ProcessLetter" targetRef="Participant_Referring" />
    <bpmn:messageFlow id="MessageFlow_S12" name="follow-up availability request" sourceRef="N_OB_ArrangeFollowUp" targetRef="Participant_Scheduling" />
  </bpmn:collaboration>
  <bpmn:process id="patient-pathway-all-entities" name="Patient pathway across all hospital entities (strategic overview)" isExecutable="false">
    <bpmn:documentation>Strategic view of the whole pathway. The eleven internal participants of the case study each own a lane (Medical Secretaries, Consultants, other clinical professionals, the Clinical Nurse Specialist Team and its administrative support, Outpatient Bookings, Treatment and Chemotherapy Bookings, Call Handling, Patient Pathway Coordinators, Finance, Administrative Management) and the seven external parties each own a black-box pool (referring GP or hospital, patient, scheduling, correspondence, treatment and imaging, Payment Service Provider, funding organisation). Non-executable: do not deploy (models/README.md). This is where the enquiry requirements FR-041 to FR-044 and the end-to-end view behind FR-005, FR-014, FR-020, FR-024, FR-028 and FR-038 sit; the executable detail is in the four operational models.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_MedicalSecretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>N_MS_ReferralReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_CheckReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_RequestMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_ProcessLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_LetterError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_MS_LetterDistributed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consultants" name="Consultants">
        <bpmn:flowNodeRef>N_C_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_ReferralDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_Redirected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_PatientAttends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_AssessPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_PrepareLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_PreCycleReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_FitToContinue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_C_ModifyTreatment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OtherClinical" name="Other Clinical Professionals">
        <bpmn:flowNodeRef>N_OCL_FollowUpRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OCL_RequestFollowUp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CnsTeam" name="Clinical Nurse Specialist Team">
        <bpmn:flowNodeRef>N_CNS_ProvideAdvice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CnsAdmin" name="CNS Administrative Support Team">
        <bpmn:flowNodeRef>N_CNSA_RecordEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CNSA_EnquiryResolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OutpatientBookings" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>N_OB_ArrangeNewPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_SlotInPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_ConfirmAndInform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_WithinTwoWeeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_TelephonePatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_AppointmentArranged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_ArrangeFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OB_FollowUpBooked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TreatmentBookings" name="Treatment and Chemotherapy Bookings Team">
        <bpmn:flowNodeRef>N_TB_CoordinateTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_ExternalAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_KeepPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_NextCycle</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CallHandling" name="Call Handling Team">
        <bpmn:flowNodeRef>N_CH_ContactReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CH_ClassifyEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CH_EnquiryType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CH_AnswerAdministrative</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CH_EnquiryAnswered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PathwayCoordinators" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>N_PC_LetterWithinSevenDays</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_IssueReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_ReviewUnbooked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_PC_CaseReferred</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>N_F_DetermineFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_FundingApprovalRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_RecordApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_PaymentRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_ProcessPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_PaymentCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_InvestigatePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_AnswerEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_DetermineRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_ProcessRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_EnquiryResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_RefundProcessed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminManagement" name="Administrative Management Team">
        <bpmn:flowNodeRef>N_AM_ContactConsultant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_AM_EscalateHigher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_AM_Escalated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
  <bpmn:startEvent id="N_MS_ReferralReceived" name="Referral received" />
  <bpmn:task id="N_MS_CheckReferral" name="Check referral documents" />
  <bpmn:task id="N_MS_RequestMissing" name="Request missing information" />
  <bpmn:task id="N_MS_ProcessLetter" name="Process and distribute letter" />
  <bpmn:exclusiveGateway id="N_MS_LetterError" name="Suspected clinical error?" />
  <bpmn:endEvent id="N_MS_LetterDistributed" name="Clinic letter distributed" />
  <bpmn:task id="N_C_ClinicalReview" name="Clinical review of referral" />
  <bpmn:exclusiveGateway id="N_C_ReferralDecision" name="Referral decision?" />
  <bpmn:endEvent id="N_C_Rejected" name="Referral rejected" />
  <bpmn:endEvent id="N_C_Redirected" name="Referral redirected" />
  <bpmn:startEvent id="N_C_PatientAttends" name="Patient attends appointment" />
  <bpmn:task id="N_C_AssessPatient" name="Assess patient and discuss options" />
  <bpmn:task id="N_C_PrepareLetter" name="Prepare clinic letter" />
  <bpmn:task id="N_C_PreCycleReview" name="Pre-cycle review and blood test" />
  <bpmn:exclusiveGateway id="N_C_FitToContinue" name="Fit to continue treatment?" />
  <bpmn:task id="N_C_ModifyTreatment" name="Authorise treatment modification" />
  <bpmn:startEvent id="N_OCL_FollowUpRequested" name="Follow-up review requested" />
  <bpmn:task id="N_OCL_RequestFollowUp" name="Request follow-up review" />
  <bpmn:task id="N_CNS_ProvideAdvice" name="Provide clinical advice" />
  <bpmn:task id="N_CNSA_RecordEnquiry" name="Record enquiry outcome" />
  <bpmn:endEvent id="N_CNSA_EnquiryResolved" name="Clinical enquiry resolved" />
  <bpmn:task id="N_OB_ArrangeNewPatient" name="Arrange new patient appointment" />
  <bpmn:exclusiveGateway id="N_OB_SlotInPeriod" name="Slot in requested period?" />
  <bpmn:task id="N_OB_ConfirmAndInform" name="Confirm and inform patient" />
  <bpmn:exclusiveGateway id="N_OB_WithinTwoWeeks" name="Within two weeks?" />
  <bpmn:task id="N_OB_TelephonePatient" name="Telephone the patient" />
  <bpmn:endEvent id="N_OB_AppointmentArranged" name="New patient appointment arranged" />
  <bpmn:task id="N_OB_ArrangeFollowUp" name="Arrange follow-up appointment" />
  <bpmn:endEvent id="N_OB_FollowUpBooked" name="Follow-up appointment booked" />
  <bpmn:task id="N_TB_CoordinateTreatment" name="Coordinate treatment appointments" />
  <bpmn:exclusiveGateway id="N_TB_ExternalAvailable" name="External service available?" />
  <bpmn:task id="N_TB_KeepPending" name="Keep booking pending" />
  <bpmn:task id="N_TB_NextCycle" name="Book next treatment cycle" />
  <bpmn:startEvent id="N_CH_ContactReceived" name="Patient contact received" />
  <bpmn:task id="N_CH_ClassifyEnquiry" name="Classify enquiry" />
  <bpmn:exclusiveGateway id="N_CH_EnquiryType" name="Enquiry type?" />
  <bpmn:task id="N_CH_AnswerAdministrative" name="Answer administrative enquiry" />
  <bpmn:endEvent id="N_CH_EnquiryAnswered" name="Administrative enquiry answered" />
  <bpmn:exclusiveGateway id="N_PC_LetterWithinSevenDays" name="Letter within seven days?" />
  <bpmn:task id="N_PC_IssueReminder" name="Issue weekly reminder" />
  <bpmn:task id="N_PC_ReviewUnbooked" name="Review unbooked case" />
  <bpmn:endEvent id="N_PC_CaseReferred" name="Case referred to pathway team" />
  <bpmn:task id="N_F_DetermineFunding" name="Determine funding route" />
  <bpmn:exclusiveGateway id="N_F_FundingApprovalRequired" name="Funding approval required?" />
  <bpmn:task id="N_F_RecordApproval" name="Record funding approval" />
  <bpmn:exclusiveGateway id="N_F_PaymentRequired" name="Payment required from patient?" />
  <bpmn:task id="N_F_ProcessPayment" name="Process payment" />
  <bpmn:exclusiveGateway id="N_F_PaymentCompleted" name="Payment completed?" />
  <bpmn:task id="N_F_InvestigatePayment" name="Investigate unconfirmed payment" />
  <bpmn:task id="N_F_AnswerEnquiry" name="Answer funding or payment enquiry" />
  <bpmn:task id="N_F_DetermineRefund" name="Determine refund" />
  <bpmn:task id="N_F_ProcessRefund" name="Process refund" />
  <bpmn:endEvent id="N_F_EnquiryResolved" name="Payment enquiry resolved" />
  <bpmn:endEvent id="N_F_RefundProcessed" name="Refund processed" />
  <bpmn:task id="N_AM_ContactConsultant" name="Contact responsible consultant" />
  <bpmn:task id="N_AM_EscalateHigher" name="Escalate to higher management" />
  <bpmn:endEvent id="N_AM_Escalated" name="Delay escalated" />
  <bpmn:sequenceFlow id="F01" sourceRef="N_MS_ReferralReceived" targetRef="N_MS_CheckReferral" />
  <bpmn:sequenceFlow id="F02" sourceRef="N_MS_CheckReferral" targetRef="N_C_ClinicalReview" />
  <bpmn:sequenceFlow id="F03" sourceRef="N_C_ClinicalReview" targetRef="N_C_ReferralDecision" />
  <bpmn:sequenceFlow id="F04" name="rejected" sourceRef="N_C_ReferralDecision" targetRef="N_C_Rejected">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;rejected&quot;</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F05" name="redirected" sourceRef="N_C_ReferralDecision" targetRef="N_C_Redirected">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;redirected&quot;</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F06" name="further information" sourceRef="N_C_ReferralDecision" targetRef="N_MS_RequestMissing">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;further_information&quot;</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F07" sourceRef="N_MS_RequestMissing" targetRef="N_MS_CheckReferral" />
  <bpmn:sequenceFlow id="F08" name="accepted" sourceRef="N_C_ReferralDecision" targetRef="N_OB_ArrangeNewPatient">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = &quot;accepted&quot;</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F09" sourceRef="N_OB_ArrangeNewPatient" targetRef="N_OB_SlotInPeriod" />
  <bpmn:sequenceFlow id="F10" name="in period" sourceRef="N_OB_SlotInPeriod" targetRef="N_OB_ConfirmAndInform">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable = true and withinRequestedWindow = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F11" name="outside period" sourceRef="N_OB_SlotInPeriod" targetRef="N_PC_ReviewUnbooked">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= slotAvailable = false or withinRequestedWindow = false</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F12" sourceRef="N_OB_ConfirmAndInform" targetRef="N_OB_WithinTwoWeeks" />
  <bpmn:sequenceFlow id="F13" name="within two weeks" sourceRef="N_OB_WithinTwoWeeks" targetRef="N_OB_TelephonePatient">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentWithinTwoWeeks = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F14" name="later" sourceRef="N_OB_WithinTwoWeeks" targetRef="N_OB_AppointmentArranged">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentWithinTwoWeeks = false</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F15" sourceRef="N_OB_TelephonePatient" targetRef="N_OB_AppointmentArranged" />
  <bpmn:sequenceFlow id="F16" sourceRef="N_C_PatientAttends" targetRef="N_C_AssessPatient" />
  <bpmn:sequenceFlow id="F17" sourceRef="N_C_AssessPatient" targetRef="N_TB_CoordinateTreatment" />
  <bpmn:sequenceFlow id="F18" sourceRef="N_C_AssessPatient" targetRef="N_C_PrepareLetter" />
  <bpmn:sequenceFlow id="F19" sourceRef="N_C_PrepareLetter" targetRef="N_MS_ProcessLetter" />
  <bpmn:sequenceFlow id="F20" sourceRef="N_MS_ProcessLetter" targetRef="N_MS_LetterError" />
  <bpmn:sequenceFlow id="F21" name="clinical error suspected" sourceRef="N_MS_LetterError" targetRef="N_C_PrepareLetter">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suspectedClinicalError = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F22" name="no clinical error" sourceRef="N_MS_LetterError" targetRef="N_PC_LetterWithinSevenDays">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suspectedClinicalError = false</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F23" name="within seven days" sourceRef="N_PC_LetterWithinSevenDays" targetRef="N_MS_LetterDistributed">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterWithinSevenDays = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F24" name="delayed" sourceRef="N_PC_LetterWithinSevenDays" targetRef="N_PC_IssueReminder">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterWithinSevenDays = false</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F25" sourceRef="N_PC_IssueReminder" targetRef="N_AM_ContactConsultant" />
  <bpmn:sequenceFlow id="F26" sourceRef="N_AM_ContactConsultant" targetRef="N_AM_EscalateHigher" />
  <bpmn:sequenceFlow id="F27" sourceRef="N_AM_EscalateHigher" targetRef="N_AM_Escalated" />
  <bpmn:sequenceFlow id="F28" sourceRef="N_PC_ReviewUnbooked" targetRef="N_PC_CaseReferred" />
  <bpmn:sequenceFlow id="F29" sourceRef="N_TB_CoordinateTreatment" targetRef="N_TB_ExternalAvailable" />
  <bpmn:sequenceFlow id="F30" name="not available" sourceRef="N_TB_ExternalAvailable" targetRef="N_TB_KeepPending">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalServiceAvailable = false</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F31" sourceRef="N_TB_KeepPending" targetRef="N_TB_CoordinateTreatment" />
  <bpmn:sequenceFlow id="F32" name="available" sourceRef="N_TB_ExternalAvailable" targetRef="N_F_DetermineFunding">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalServiceAvailable = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F33" sourceRef="N_F_DetermineFunding" targetRef="N_F_FundingApprovalRequired" />
  <bpmn:sequenceFlow id="F34" name="required" sourceRef="N_F_FundingApprovalRequired" targetRef="N_F_RecordApproval">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingApprovalRequired = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F35" name="not required" sourceRef="N_F_FundingApprovalRequired" targetRef="N_F_PaymentRequired">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingApprovalRequired = false</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F36" sourceRef="N_F_RecordApproval" targetRef="N_F_PaymentRequired" />
  <bpmn:sequenceFlow id="F37" name="payment required" sourceRef="N_F_PaymentRequired" targetRef="N_F_ProcessPayment">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentRequiredFromPatient = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F38" name="no payment due" sourceRef="N_F_PaymentRequired" targetRef="N_C_PreCycleReview">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentRequiredFromPatient = false</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F39" sourceRef="N_F_ProcessPayment" targetRef="N_F_PaymentCompleted" />
  <bpmn:sequenceFlow id="F40" name="unconfirmed" sourceRef="N_F_PaymentCompleted" targetRef="N_F_InvestigatePayment">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= confirmationReceived = false</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F41" name="confirmed" sourceRef="N_F_PaymentCompleted" targetRef="N_C_PreCycleReview">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = &quot;completed&quot; and confirmationReceived = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F42" sourceRef="N_F_InvestigatePayment" targetRef="N_C_PreCycleReview" />
  <bpmn:sequenceFlow id="F43" sourceRef="N_C_PreCycleReview" targetRef="N_C_FitToContinue" />
  <bpmn:sequenceFlow id="F44" name="fit" sourceRef="N_C_FitToContinue" targetRef="N_TB_NextCycle">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fitToContinue = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F45" name="not fit" sourceRef="N_C_FitToContinue" targetRef="N_C_ModifyTreatment">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fitToContinue = false</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F46" sourceRef="N_TB_NextCycle" targetRef="N_TB_CoordinateTreatment" />
  <bpmn:sequenceFlow id="F47" name="affects charge or funding" sourceRef="N_C_ModifyTreatment" targetRef="N_F_DetermineRefund">
    <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= affectsCharge = true</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="F48" sourceRef="N_F_DetermineRefund" targetRef="N_F_ProcessRefund" />
  <bpmn:sequenceFlow id="F49" sourceRef="N_F_ProcessRefund" targetRef="N_F_RefundProcessed" />
  <bpmn:sequenceFlow id="F50" sourceRef="N_CH_ContactReceived" targetRef="N_CH_ClassifyEnquiry" />

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_core-2-treatment-authorisation-funding-and-payment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:error id="Error_INVALID_VARIABLE" name="INVALID_VARIABLE" errorCode="INVALID_VARIABLE" />
  <bpmn:error id="Error_PROHIBITED_FINANCIAL_DATA" name="PROHIBITED_FINANCIAL_DATA" errorCode="PROHIBITED_FINANCIAL_DATA" />
  <bpmn:error id="Error_UNAUTHORISED_BOOKING_REQUEST" name="UNAUTHORISED_BOOKING_REQUEST" errorCode="UNAUTHORISED_BOOKING_REQUEST" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hospital" name="Hospital Trust" processRef="core-2-treatment-authorisation-funding-and-payment" />
    <bpmn:participant id="Participant_Patient" name="Patient or authorised representative" />
    <bpmn:participant id="Participant_TreatmentService" name="External treatment, laboratory and imaging service" />
    <bpmn:participant id="Participant_PaymentProvider" name="External Payment Service Provider" />
    <bpmn:participant id="Participant_FundingOrganisation" name="Approved insurer or funding organisation" />
    <bpmn:messageFlow id="MessageFlow_M1" name="patient attends" sourceRef="Participant_Patient" targetRef="N_CL_AssessPatient" />
    <bpmn:messageFlow id="MessageFlow_M2" name="treatment availability request" sourceRef="N_TB_CheckAvailability" targetRef="Participant_TreatmentService" />
    <bpmn:messageFlow id="MessageFlow_M3" name="funding approval request" sourceRef="N_F_RecordApproval" targetRef="Participant_FundingOrganisation" />
    <bpmn:messageFlow id="MessageFlow_M4" name="secure payment request" sourceRef="N_F_ProcessPayment" targetRef="Participant_PaymentProvider" />
    <bpmn:messageFlow id="MessageFlow_M5" name="treatment appointment details" sourceRef="N_TB_NotifyPatient" targetRef="Participant_Patient" />
    <bpmn:messageFlow id="MessageFlow_M6" name="repeat availability request" sourceRef="N_TB_KeepPending" targetRef="Participant_TreatmentService" />
  </bpmn:collaboration>
  <bpmn:process id="core-2-treatment-authorisation-funding-and-payment" name="Core 2 - Treatment authorisation, funding determination and payment" isExecutable="true">
    <bpmn:documentation>Covers FR-007 to FR-009, FR-017 to FR-035 and BR-10 to BR-25, EX-10 to EX-16. Service tasks use the job types and the variable contract of workers/README.md. The error codes are caught on the service task that raises them - UNAUTHORISED_BOOKING_REQUEST and INVALID_VARIABLE on check-treatment-availability, PROHIBITED_FINANCIAL_DATA and INVALID_VARIABLE on process-payment, INVALID_VARIABLE on send-correspondence - because error variables are written to the scope of the activity that raised them and do not survive into the process scope: the reason for a failure is told apart by which boundary event was taken. A treatment appointment the patient declines or the hospital cancels is recorded with the decisions that follow it (BR-39, BR-40, EX-20), and a patient who asks for another date has the change recorded and the booking sought again.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>N_F_DetermineFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_FundingApprovalRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_RecordApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_PaymentRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_MergeChargeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_CalculateCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_ProcessPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_PaymentStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_MergePaymentCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_CorrectPaymentRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_InvestigatePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_InvestigationComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_NotifyPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_ReviewFinancialImpact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_ImpactReviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_RetryDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_F_PaymentNotPursued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_F_InvalidVariables</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_F_ProhibitedData</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TreatmentBookings" name="Treatment and Chemotherapy Bookings Team">
        <bpmn:flowNodeRef>N_TB_VerifyAuthorisation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_MergeBookingInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_CheckAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_AvailabilityDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_MergeConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_ConfirmAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_ConfirmationOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_RescheduleAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_RecordCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_MergeNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_ReturnRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_KeepPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_CorrectBookingInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_RecordNotificationFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_AppointmentCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_TB_InvalidVariables</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_TB_Unauthorised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_TB_NotifyPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_TB_NotifyFailure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OtherClinical" name="Other Clinical Professionals">
        <bpmn:flowNodeRef>N_OC_PreCycleReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_OC_FitToContinue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ClinicalTeam" name="Consultant and clinical team">
        <bpmn:flowNodeRef>N_CL_PatientAttends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CL_AssessPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CL_ConsentDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CL_NotProceeding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CL_MergeAuthorisation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CL_AuthoriseTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CL_ClinicalRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CL_ModifyTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_CL_UrgentAuthorise</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N_CL_PatientAttends" name="Patient attends the appointment">
      <bpmn:documentation>The patient attends the New Patient Appointment (FR-007).</bpmn:documentation>
    </bpmn:startEvent>
    <bpmn:userTask id="N_CL_AssessPatient" name="Assess patient and treatment options">
      <bpmn:documentation>Clinical task: assess the patient, discuss the diagnosis and explain the treatment options (BR-25, FR-007).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="patient-assessment" />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_CL_ConsentDecision" name="Patient consents to proceed?" default="F3">
      <bpmn:documentation>Consent is recorded before any Treatment Booking Request is created (BR-10, FR-007).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="N_CL_NotProceeding" name="Patient does not proceed">
      <bpmn:documentation>The patient does not agree to proceed; no request is created (FR-007).</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="N_CL_MergeAuthorisation" name="Consent given or request returned">
      <bpmn:documentation>Merges the paths that reach Record consent and authorise request (Patient consents to proceed?, Return request for authorisation). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. Consent recorded at the consultation and a request returned for authorisation are both authorised by the clinical team (BR-10, BR-11, FR-008).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_CL_AuthoriseTreatment" name="Record consent and authorise request">
      <bpmn:documentation>Clinical authorisation of the Treatment Booking Request: proposed treatment, start date, number and frequency of cycles, reviews between cycles, special resources, authorising professional (BR-10, BR-11, FR-007, FR-019). Supplies clinicalAuthorised and the treatment availability inputs.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="treatment-booking" />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_CL_ClinicalRisk" name="Delaying care is a clinical risk?" default="F31">
      <bpmn:documentation>EX-13, BR-19: allows urgent treatment although payment is not confirmed (FR-032).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_CL_ModifyTreatment" name="Authorise treatment modification">
      <bpmn:documentation>Only a formally submitted Treatment Modification Request through the system is processed; requests made by email, telephone or informal communication are refused (BR-22, EX-15, FR-020).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="treatment-modification" />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_CL_UrgentAuthorise" name="Authorise urgent treatment">
      <bpmn:documentation>Records the reason for proceeding without confirmed payment and refers the case to the Finance Team for resolution (BR-19, EX-13, FR-032).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="urgent-authorisation" />
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_OC_PreCycleReview" name="Review the patient and the blood test">
      <bpmn:documentation>Before each subsequent cycle: review, blood test results and the clinical decision on fitness to continue (BR-25, FR-009).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="pre-cycle-review" />
        <zeebe:assignmentDefinition candidateGroups="clinical-professionals" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_OC_FitToContinue" name="Patient fit to continue?" default="F40">
      <bpmn:documentation>Fit / delay or change the plan; a clinical decision that administrative roles cannot take (BR-25, BR-41, FR-009).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_TB_VerifyAuthorisation" name="Verify treatment authorisation">
      <bpmn:documentation>Administrative check that the request is complete and clinically authorised; supplies clinicalAuthorised to the availability check (BR-10, FR-008).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="authorisation-verification" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_TB_MergeBookingInput" name="Verified, corrected, pending or rescheduled">
      <bpmn:documentation>Merges the paths that reach Check treatment availability (Verify treatment authorisation, Correct booking input, Keep booking pending, Record the requested change). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. A verified request, one whose input was corrected, one kept pending while the service was unavailable and one rescheduled at the patient's request all ask the treatment service the same question (BR-12, FR-016, FR-017).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N_TB_CheckAvailability" name="Check treatment availability">
      <bpmn:documentation>Job type check-treatment-availability (worker treatment-availability; simulates the external treatment, laboratory and imaging service). Input: proposedTreatment, treatmentStartDate, specialResources, clinicalAuthorised. Output: externalServiceAvailable, treatmentSlotAvailable, appointmentReference, treatmentAppointmentDate, bookingStatus, treatmentRetryCount, duplicateAttempt. Errors: UNAUTHORISED_BOOKING_REQUEST, INVALID_VARIABLE (BR-10, BR-12, FR-017, FR-018).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-treatment-availability" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N_TB_AvailabilityDecision" name="Service available?" default="F13">
      <bpmn:documentation>Reads externalServiceAvailable; bookingStatus stays pending when the service is unavailable (BR-12, EX-10, FR-018).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="N_TB_MergeConfirmation" name="Ready to confirm">
      <bpmn:documentation>Merges the paths that reach Confirm treatment appointment (Authorise urgent treatment, Patient fit to continue?, Payment required from patient?, Payment completed?). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. Authority to treat urgently, a review between cycles, a funded route and a settled payment all leave the appointment ready to confirm, and confirmation is gated on one of them (BR-13, BR-15, BR-19).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_TB_ConfirmAppointment" name="Confirm treatment appointment">
      <bpmn:documentation>Confirmation only after the funding route and, where required, the payment or an authorised exemption are in place (BR-15, FR-029).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="appointment-confirmation" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_TB_ConfirmationOutcome" name="Outcome of the confirmation contact?" default="F50">
      <bpmn:documentation>Routes on confirmationOutcome, which the appointment-confirmation form writes. Confirmed and a patient who did not answer keep the appointment and the patient is notified; a reschedule records the date the patient asked for and the booking is sought again; a decline or a cancellation by the hospital is recorded and the appointment released (BR-15, BR-39, BR-40, EX-20, FR-029).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_TB_RescheduleAppointment" name="Record the requested change">
      <bpmn:documentation>Records the date the patient asked for and why the appointment is moving, and that the patient has been told. The booking is then sought again for the new request, which carries a new start date and so is a new booking: the appointment it replaces is superseded on the register rather than left as though it were still going to happen (BR-39, EX-20, FR-016).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="appointment-reschedule" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_TB_RecordCancellation" name="Record the cancelled appointment">
      <bpmn:documentation>Records a treatment appointment the patient declined or the hospital cancelled, and the decisions that follow it: whether another appointment is offered, whether the pathway needs a clinical review, and whether a paid appointment is affected. A paid appointment is the Finance Team's to settle, which is what the cancellation path of the follow-up process exists for (BR-39, BR-40, EX-20).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="cancellation-record" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_TB_MergeNotification" name="Patient notified">
      <bpmn:documentation>Merges the paths that reach Notify patient of appointment (Record notification failure, Outcome of the confirmation contact?). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. The notification after a confirmation and the one after a notification failure reach the same dispatch (FR-039, EX-11).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_TB_ReturnRequest" name="Return request for authorisation">
      <bpmn:documentation>Handles UNAUTHORISED_BOOKING_REQUEST: the request has no clinical authorisation and is not processed; it is returned to the clinical role (BR-10, FR-008).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="authorisation-return" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_TB_KeepPending" name="Keep booking pending">
      <bpmn:documentation>EX-10: the booking stays pending, the responsible team is notified, further attempts are recorded and no duplicate appointment is created (BR-12, FR-018).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="booking-pending" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_TB_CorrectBookingInput" name="Correct booking input">
      <bpmn:documentation>Handles INVALID_VARIABLE on check-treatment-availability: a required variable is missing, of the wrong type or contradicts another value, so the booking request is corrected and the availability check is re-run without creating a duplicate appointment (FR-018).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="treatment-booking" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_TB_RecordNotificationFailure" name="Record notification failure">
      <bpmn:documentation>Handles INVALID_VARIABLE on send-correspondence: the notification was not dispatched because a required variable (for example the recipient list) was unusable; the failure is recorded and the patient is informed through another channel (FR-012, NFR-008, NFR-011).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="dispatch-failure" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_F_DetermineFunding" name="Determine funding route">
      <bpmn:documentation>Hospital-funded, insurer or funding organisation, or patient payment (BR-13, FR-025). A hospital, insurer or exempt route means the payment provider is not called at all.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="funding-route" />
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_F_FundingApprovalRequired" name="Funding approval required?" default="F16">
      <bpmn:documentation>BR-13, BR-14, FR-025, FR-026.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_F_RecordApproval" name="Record funding approval">
      <bpmn:documentation>Records the funding organisation, authorisation reference, approved amount and any limitations (BR-14, FR-026).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="funding-approval" />
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_F_PaymentRequired" name="Payment required from patient?" default="F19">
      <bpmn:documentation>Most eligible patients pay nothing; charges may apply to private patients, overseas visitors, optional services or excluded treatments (BR-13, FR-025).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="N_F_MergeChargeRequest" name="Charge, correction or retry">
      <bpmn:documentation>Merges the paths that reach Calculate or obtain the charge (Payment required from patient?, Correct the payment request, Another payment attempt?). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. The first charge, a charge re-entered after the input was refused and a retry after a declined payment are the same request to the patient (BR-17, EX-11).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_F_CalculateCharge" name="Calculate or obtain the charge">
      <bpmn:documentation>Supplies chargeAmount, fundingRoute and paymentReference to process-payment (AS-08, BR-15, FR-027).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="payment" />
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="N_F_ProcessPayment" name="Process payment">
      <bpmn:documentation>Job type process-payment (worker payment-processing; simulates the external Payment Service Provider). Input: chargeAmount, fundingRoute, paymentReference. Output: paymentStatus, transactionReference, paymentDate, paidAmount, confirmationReceived, requiresInvestigation, duplicateAttempt. Errors: PROHIBITED_FINANCIAL_DATA, INVALID_VARIABLE. The provider is not called at all when paymentStatus is not_required (hospital, insurer or exempt route) (BR-15, BR-16, BR-17, BR-18, FR-027 to FR-031).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-payment" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N_F_PaymentStatus" name="Payment completed?" default="F27">
      <bpmn:documentation>Reads paymentStatus, confirmationReceived and requiresInvestigation (BR-17, BR-18, EX-11, EX-12, FR-030, FR-031).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="N_F_MergePaymentCorrection" name="Payment input refused">
      <bpmn:documentation>Merges the paths that reach Correct the payment request (prohibited financial data, invalid payment variables). The merge is exclusive - each token that arrives continues on its own - and it is drawn rather than left implicit at the activity. A request carrying card or security details and one whose variables are unusable need the same correction before anything is sent to the provider (BR-16, NFR-007).</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_F_CorrectPaymentRequest" name="Correct the payment request">
      <bpmn:documentation>Handles PROHIBITED_FINANCIAL_DATA (card or security details must never reach the system, BR-16, NFR-007) and INVALID_VARIABLE (the request variables are unusable). In both cases the provider is not called again until the request is correct, and no second charge is created (BR-17, FR-028, FR-030). The two repair paths arrive through Merge payment correction rather than at the task, so this convergence is drawn as a gateway like the others.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="payment" />
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_F_InvestigatePayment" name="Mark transaction for investigation">
      <bpmn:documentation>EX-12, BR-18: payment taken but confirmation not returned; the transaction is marked for investigation and no further payment request is issued (FR-031).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="payment-investigation" />
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="N_F_InvestigationComplete" name="Transaction investigation recorded">
      <bpmn:documentation>The investigation outcome is recorded against the patient account (BR-18, FR-031).</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:userTask id="N_F_NotifyPatient" name="Notify patient and booking team">
      <bpmn:documentation>EX-11, BR-17: the patient and the responsible administrative team are notified; another attempt is possible without a duplicate booking or a second charge (FR-030).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="payment-notification" />
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="N_F_ReviewFinancialImpact" name="Review the financial impact">
      <bpmn:documentation>BR-24, FR-022: a modification that affects an existing charge, funding approval or completed payment is reviewed by Finance.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="financial-impact-review" />
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="N_F_ImpactReviewed" name="Charge or funding reviewed" />
    <bpmn:exclusiveGateway id="N_F_RetryDecision" name="Another payment attempt?" default="F44">
      <bpmn:documentation>Reads retryPayment (BR-17, EX-11, FR-030). BR-17 requires another attempt to be possible rather than to be taken, so an unanswered question ends the case without moving money again.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="N_F_PaymentNotPursued" name="Payment not pursued">
      <bpmn:documentation>EX-11, BR-17, FR-030: the patient and the responsible administrative team have been notified and no further attempt is to be made, so the case closes with the payment uncollected.</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:endEvent id="N_TB_AppointmentCancelled" name="Treatment appointment not confirmed" />
    <bpmn:boundaryEvent id="B_F_InvalidVariables" name="invalid payment input" attachedToRef="N_F_ProcessPayment">
      <bpmn:errorEventDefinition errorRef="Error_INVALID_VARIABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_F_ProhibitedData" name="prohibited financial data" attachedToRef="N_F_ProcessPayment">
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_PROHIBITED_FINANCIAL_DATA" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_TB_InvalidVariables" name="invalid booking input" attachedToRef="N_TB_CheckAvailability">
      <bpmn:errorEventDefinition errorRef="Error_INVALID_VARIABLE" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_TB_Unauthorised" name="request not authorised" attachedToRef="N_TB_CheckAvailability">
      <bpmn:errorEventDefinition errorRef="Error_UNAUTHORISED_BOOKING_REQUEST" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="N_CL_PatientAttends" targetRef="N_CL_AssessPatient" />
    <bpmn:sequenceFlow id="F2" sourceRef="N_CL_AssessPatient" targetRef="N_CL_ConsentDecision" />
    <bpmn:sequenceFlow id="F3" name="declined" sourceRef="N_CL_ConsentDecision" targetRef="N_CL_NotProceeding" />
    <bpmn:sequenceFlow id="F4" name="consented" sourceRef="N_CL_ConsentDecision" targetRef="N_CL_MergeAuthorisation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="N_TB_ReturnRequest" targetRef="N_CL_MergeAuthorisation" />
    <bpmn:sequenceFlow id="MF1" sourceRef="N_CL_MergeAuthorisation" targetRef="N_CL_AuthoriseTreatment" />
    <bpmn:sequenceFlow id="F5" sourceRef="N_CL_AuthoriseTreatment" targetRef="N_TB_VerifyAuthorisation" />
    <bpmn:sequenceFlow id="F27" name="not completed" sourceRef="N_F_PaymentStatus" targetRef="N_CL_ClinicalRisk" />
    <bpmn:sequenceFlow id="F30" name="yes" sourceRef="N_CL_ClinicalRisk" targetRef="N_CL_UrgentAuthorise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= delayingCareIsClinicalRisk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F31" name="no" sourceRef="N_CL_ClinicalRisk" targetRef="N_F_NotifyPatient" />
    <bpmn:sequenceFlow id="F40" name="not fit" sourceRef="N_OC_FitToContinue" targetRef="N_CL_ModifyTreatment" />
    <bpmn:sequenceFlow id="F41" name="affects charge or payment" sourceRef="N_CL_ModifyTreatment" targetRef="N_F_ReviewFinancialImpact">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= affectsCharge = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F33" sourceRef="N_CL_UrgentAuthorise" targetRef="N_TB_MergeConfirmation" />
    <bpmn:sequenceFlow id="F37" sourceRef="N_TB_NotifyPatient" targetRef="N_OC_PreCycleReview" />
    <bpmn:sequenceFlow id="F38" sourceRef="N_OC_PreCycleReview" targetRef="N_OC_FitToContinue" />
    <bpmn:sequenceFlow id="F39" name="fit" sourceRef="N_OC_FitToContinue" targetRef="N_TB_MergeConfirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fitToContinue = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="N_TB_VerifyAuthorisation" targetRef="N_TB_MergeBookingInput" />
    <bpmn:sequenceFlow id="F10" sourceRef="N_TB_CorrectBookingInput" targetRef="N_TB_MergeBookingInput" />
    <bpmn:sequenceFlow id="F14" sourceRef="N_TB_KeepPending" targetRef="N_TB_MergeBookingInput" />
    <bpmn:sequenceFlow id="F53" sourceRef="N_TB_RescheduleAppointment" targetRef="N_TB_MergeBookingInput" />
    <bpmn:sequenceFlow id="MF2" sourceRef="N_TB_MergeBookingInput" targetRef="N_TB_CheckAvailability" />
    <bpmn:sequenceFlow id="F11" sourceRef="N_TB_CheckAvailability" targetRef="N_TB_AvailabilityDecision" />
    <bpmn:sequenceFlow id="F12" name="available" sourceRef="N_TB_AvailabilityDecision" targetRef="N_F_DetermineFunding">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalServiceAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" name="not available" sourceRef="N_TB_AvailabilityDecision" targetRef="N_TB_KeepPending" />
    <bpmn:sequenceFlow id="F20" name="no payment due" sourceRef="N_F_PaymentRequired" targetRef="N_TB_MergeConfirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentRequiredFromPatient = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F26" name="completed" sourceRef="N_F_PaymentStatus" targetRef="N_TB_MergeConfirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "completed" and confirmationReceived = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="MF3" sourceRef="N_TB_MergeConfirmation" targetRef="N_TB_ConfirmAppointment" />
    <bpmn:sequenceFlow id="F34" sourceRef="N_TB_ConfirmAppointment" targetRef="N_TB_ConfirmationOutcome" />
    <bpmn:sequenceFlow id="F51" name="confirmed or no response" sourceRef="N_TB_ConfirmationOutcome" targetRef="N_TB_MergeNotification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= confirmationOutcome = "confirmed" or confirmationOutcome = "no_response"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F52" name="reschedule requested" sourceRef="N_TB_ConfirmationOutcome" targetRef="N_TB_RescheduleAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= confirmationOutcome = "reschedule_requested"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F50" name="declined or cancelled" sourceRef="N_TB_ConfirmationOutcome" targetRef="N_TB_RecordCancellation" />
    <bpmn:sequenceFlow id="F54" sourceRef="N_TB_RecordCancellation" targetRef="N_TB_AppointmentCancelled" />
    <bpmn:sequenceFlow id="F36" sourceRef="N_TB_RecordNotificationFailure" targetRef="N_TB_MergeNotification" />
    <bpmn:sequenceFlow id="MF4" sourceRef="N_TB_MergeNotification" targetRef="N_TB_NotifyPatient" />
    <bpmn:sequenceFlow id="F6" sourceRef="B_TB_Unauthorised" targetRef="N_TB_ReturnRequest" />
    <bpmn:sequenceFlow id="F9" sourceRef="B_TB_InvalidVariables" targetRef="N_TB_CorrectBookingInput" />
    <bpmn:sequenceFlow id="F35" sourceRef="B_TB_NotifyFailure" targetRef="N_TB_RecordNotificationFailure" />
    <bpmn:sequenceFlow id="F15" sourceRef="N_F_DetermineFunding" targetRef="N_F_FundingApprovalRequired" />
    <bpmn:sequenceFlow id="F16" name="required" sourceRef="N_F_FundingApprovalRequired" targetRef="N_F_RecordApproval" />
    <bpmn:sequenceFlow id="F17" name="not required" sourceRef="N_F_FundingApprovalRequired" targetRef="N_F_PaymentRequired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingApprovalRequired = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F18" sourceRef="N_F_RecordApproval" targetRef="N_F_PaymentRequired" />
    <bpmn:sequenceFlow id="F19" name="payment required" sourceRef="N_F_PaymentRequired" targetRef="N_F_MergeChargeRequest" />
    <bpmn:sequenceFlow id="F24" sourceRef="N_F_CorrectPaymentRequest" targetRef="N_F_MergeChargeRequest" />
    <bpmn:sequenceFlow id="F43" name="retry payment" sourceRef="N_F_RetryDecision" targetRef="N_F_MergeChargeRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryPayment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="MF5" sourceRef="N_F_MergeChargeRequest" targetRef="N_F_CalculateCharge" />
    <bpmn:sequenceFlow id="F21" sourceRef="N_F_CalculateCharge" targetRef="N_F_ProcessPayment" />
    <bpmn:sequenceFlow id="F25" sourceRef="N_F_ProcessPayment" targetRef="N_F_PaymentStatus" />
    <bpmn:sequenceFlow id="F28" name="taken but unconfirmed" sourceRef="N_F_PaymentStatus" targetRef="N_F_InvestigatePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requiresInvestigation = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F22" sourceRef="B_F_ProhibitedData" targetRef="N_F_MergePaymentCorrection" />
    <bpmn:sequenceFlow id="F23" sourceRef="B_F_InvalidVariables" targetRef="N_F_MergePaymentCorrection" />
    <bpmn:sequenceFlow id="MF6" sourceRef="N_F_MergePaymentCorrection" targetRef="N_F_CorrectPaymentRequest" />
    <bpmn:sequenceFlow id="F29" sourceRef="N_F_InvestigatePayment" targetRef="N_F_InvestigationComplete" />
    <bpmn:sequenceFlow id="F32" sourceRef="N_F_NotifyPatient" targetRef="N_F_RetryDecision" />
    <bpmn:sequenceFlow id="F42" sourceRef="N_F_ReviewFinancialImpact" targetRef="N_F_ImpactReviewed" />
    <bpmn:sequenceFlow id="F44" name="no further attempt" sourceRef="N_F_RetryDecision" targetRef="N_F_PaymentNotPursued" />
    <bpmn:boundaryEvent id="B_TB_NotifyFailure" name="notification failed" attachedToRef="N_TB_NotifyPatient">
      <bpmn:errorEventDefinition errorRef="Error_INVALID_VARIABLE" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="N_TB_NotifyPatient" name="Notify patient of appointment">
      <bpmn:documentation>Job type send-correspondence (worker correspondence-dispatch; simulates the external correspondence service). Input: recipients, documentType, channelPreference. Output: dispatchDate, dispatchChannel, dispatchReference. Error: INVALID_VARIABLE (FR-039, NFR-011).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-correspondence" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
  </bpmn:process>

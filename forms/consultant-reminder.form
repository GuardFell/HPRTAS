{
  "id": "consultant-reminder",
  "components": [
    {
      "type": "group",
      "label": "Reminder",
      "components": [
        {
          "type": "textfield",
          "key": "consultationId",
          "label": "Consultation ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "number",
          "key": "reminderNumber",
          "label": "Reminder Number",
          "validate": {
            "required": true,
            "min": 1,
            "max": 52
          }
        },
        {
          "type": "datetime",
          "subtype": "date",
          "dateLabel": "Date",
          "key": "reminderDate",
          "label": "Reminder Date",
          "validate": {
            "required": true
          }
        },
        {
          "type": "select",
          "key": "overdueDuration",
          "label": "How Overdue the Letter Is",
          "description": "Decides whether the delay stays with the Consultant or is escalated.",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Less Than One Month",
              "value": "less_than_one_month"
            },
            {
              "label": "One to Three Months",
              "value": "one_to_three_months"
            },
            {
              "label": "More Than Three Months",
              "value": "over_three_months"
            }
          ]
        },
        {
          "type": "textfield",
          "key": "reminderTo",
          "label": "Reminder To",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textarea",
          "key": "reminderResponse",
          "label": "Response to the Reminder",
          "description": "Kept as part of the record of reminders and responses.",
          "validate": {
            "maxLength": 2000
          }
        },
        {
          "type": "textarea",
          "key": "delayReason",
          "label": "Valid Reason for the Delay",
          "description": "Where the Consultant gives one, so the reason is retained with the reminder.",
          "validate": {
            "maxLength": 2000,
            "minLength": 5
          }
        },
        {
          "type": "textfield",
          "key": "issuedBy",
          "label": "Issued By",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

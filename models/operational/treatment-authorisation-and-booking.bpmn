<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_treatment-authorisation-and-booking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <!-- Core process 2 of 3. Consent and treatment authorisation, funding-route determination,
     payment through the external Payment Service Provider with its failure paths (declined,
     duplicated, taken without confirmation, urgent clinical override), treatment booking with
     external services and the between-cycle clinical review. Job types: check-treatment-
     availability, process-payment. -->
  <bpmn:error id="Error_InvalidVariable" name="INVALID_VARIABLE" errorCode="INVALID_VARIABLE" />
  <bpmn:error id="Error_UnauthorisedBooking" name="UNAUTHORISED_BOOKING_REQUEST" errorCode="UNAUTHORISED_BOOKING_REQUEST" />
  <bpmn:error id="Error_ProhibitedFinancialData" name="PROHIBITED_FINANCIAL_DATA" errorCode="PROHIBITED_FINANCIAL_DATA" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hospital" name="Hospital Trust" processRef="treatment-authorisation-and-booking" />
    <bpmn:participant id="Participant_TreatmentService" name="Treatment and imaging service" />
    <bpmn:participant id="Participant_PaymentProvider" name="Payment Service Provider" />
    <bpmn:participant id="Participant_FundingOrganisation" name="Funding organisation" />
    <bpmn:messageFlow id="MessageFlow_B1" name="funding approval" sourceRef="UserTask_RecordFundingApproval" targetRef="Participant_FundingOrganisation" />
    <bpmn:messageFlow id="MessageFlow_B2" name="payment request and status" sourceRef="ServiceTask_ProcessPayment" targetRef="Participant_PaymentProvider" />
    <bpmn:messageFlow id="MessageFlow_B3" name="refund request" sourceRef="UserTask_SendRefundRequest" targetRef="Participant_PaymentProvider" />
    <bpmn:messageFlow id="MessageFlow_B4" name="availability request" sourceRef="ServiceTask_CheckTreatmentAvailability" targetRef="Participant_TreatmentService" />
  </bpmn:collaboration>
  <bpmn:process id="treatment-authorisation-and-booking" name="Treatment authorisation, funding, payment and treatment booking" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Clinical" name="Clinical Team">
        <bpmn:flowNodeRef>StartEvent_NewPatientAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AssessAndAuthoriseTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TreatmentAuthorised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoTreatmentAgreed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClinicalRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AuthoriseUrgentTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PreTreatmentReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FitToContinue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RequestTreatmentModification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinancialImpact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TreatmentModified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreCycles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TreatmentComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OtherClinical" name="Other Clinical Professionals">
        <bpmn:flowNodeRef>UserTask_AuthoriseTreatmentModification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TreatmentBookings" name="Treatment Bookings">
        <bpmn:flowNodeRef>UserTask_PrepareTreatmentBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckTreatmentAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReturnForAuthorisation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CorrectTreatmentRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExternalServiceAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordPendingBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FundingAndPaymentConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConfirmTreatmentAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error_UnauthorisedBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error_TreatmentRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>UserTask_DetermineFundingRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FundingRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordFundingApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CalculateCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ProcessPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_CorrectPaymentRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfirmationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_MarkForInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordPaymentAndReleaseAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetryPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AppointmentNotConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReferChargeToFinance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DetermineRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendRefundRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordRefundResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RefundRecorded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error_ProhibitedData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error_PaymentRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PatientAdmin" name="Patient and Admin">
        <bpmn:flowNodeRef>UserTask_NotifyPatientAndTeam</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_NewPatientAppointment" name="New patient appointment" />
    <bpmn:userTask id="UserTask_AssessAndAuthoriseTreatment" name="Assess and authorise treatment">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TreatmentAuthorised" name="Authorised?" />
    <bpmn:endEvent id="EndEvent_NoTreatmentAgreed" name="No treatment agreed" />
    <bpmn:exclusiveGateway id="Gateway_ClinicalRisk" name="Clinical risk?" />
    <bpmn:userTask id="UserTask_AuthoriseUrgentTreatment" name="Authorise urgent treatment">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_PreTreatmentReview" name="Pre-cycle review and blood test">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="clinical-nurse-specialists" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FitToContinue" name="Fit to continue?" />
    <bpmn:userTask id="UserTask_RequestTreatmentModification" name="Request treatment change">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FinancialImpact" name="Charge or payment affected?" />
    <bpmn:endEvent id="EndEvent_TreatmentModified" name="Treatment plan changed" />
    <bpmn:exclusiveGateway id="Gateway_MoreCycles" name="More cycles?" />
    <bpmn:endEvent id="EndEvent_TreatmentComplete" name="Treatment complete" />
    <bpmn:userTask id="UserTask_AuthoriseTreatmentModification" name="Authorise treatment change">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="clinical-professionals" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_PrepareTreatmentBooking" name="Plan treatment and resources">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_CheckTreatmentAvailability" name="Check treatment slots">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-treatment-availability" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_ReturnForAuthorisation" name="Return for authorisation">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_CorrectTreatmentRequest" name="Correct treatment request">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ExternalServiceAvailable" name="Service available?" />
    <bpmn:userTask id="UserTask_RecordPendingBooking" name="Keep booking pending">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FundingAndPaymentConfirmed" name="Funding or payment confirmed?" />
    <bpmn:userTask id="UserTask_ConfirmTreatmentAppointment" name="Confirm treatment appointment">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_DetermineFundingRoute" name="Determine funding route">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FundingRoute" name="Funding route?" />
    <bpmn:userTask id="UserTask_RecordFundingApproval" name="Record funding approval">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentRequired" name="Payment required?" />
    <bpmn:userTask id="UserTask_CalculateCharge" name="Calculate charge">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_ProcessPayment" name="Process payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="process-payment" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_CorrectPaymentRequest" name="Correct payment request">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentStatus" name="Payment status?" />
    <bpmn:exclusiveGateway id="Gateway_ConfirmationReceived" name="Confirmation received?" />
    <bpmn:userTask id="UserTask_MarkForInvestigation" name="Mark for investigation">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_RecordPaymentAndReleaseAppointment" name="Record payment">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RetryPayment" name="Retry payment?" />
    <bpmn:endEvent id="EndEvent_AppointmentNotConfirmed" name="Appointment not confirmed" />
    <bpmn:userTask id="UserTask_ReferChargeToFinance" name="Resolve unpaid charge">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_DetermineRefund" name="Determine refund">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_SendRefundRequest" name="Send refund request">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_RecordRefundResult" name="Record refund">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_RefundRecorded" name="Refund recorded" />
    <bpmn:userTask id="UserTask_NotifyPatientAndTeam" name="Notify patient and team">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="administrative-team" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_Error_UnauthorisedBooking" name="not authorised" attachedToRef="ServiceTask_CheckTreatmentAvailability">
      <bpmn:errorEventDefinition errorRef="Error_UnauthorisedBooking" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Error_TreatmentRequest" name="invalid input" attachedToRef="ServiceTask_CheckTreatmentAvailability">
      <bpmn:errorEventDefinition errorRef="Error_InvalidVariable" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Error_ProhibitedData" name="card data" attachedToRef="ServiceTask_ProcessPayment">
      <bpmn:errorEventDefinition errorRef="Error_ProhibitedFinancialData" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Error_PaymentRequest" name="invalid input" attachedToRef="ServiceTask_ProcessPayment">
      <bpmn:errorEventDefinition errorRef="Error_InvalidVariable" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_B1" sourceRef="StartEvent_NewPatientAppointment" targetRef="UserTask_AssessAndAuthoriseTreatment" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="UserTask_AssessAndAuthoriseTreatment" targetRef="Gateway_TreatmentAuthorised" />
    <bpmn:sequenceFlow id="Flow_B3" name="authorised" sourceRef="Gateway_TreatmentAuthorised" targetRef="UserTask_DetermineFundingRoute">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentAuthorised = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B4" name="not authorised" sourceRef="Gateway_TreatmentAuthorised" targetRef="EndEvent_NoTreatmentAgreed" />
    <bpmn:sequenceFlow id="Flow_B5" sourceRef="UserTask_DetermineFundingRoute" targetRef="Gateway_FundingRoute" />
    <bpmn:sequenceFlow id="Flow_B6" name="insurer" sourceRef="Gateway_FundingRoute" targetRef="UserTask_RecordFundingApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = &quot;insurer&quot; or fundingRoute = &quot;funding_organisation&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B7" name="hospital" sourceRef="Gateway_FundingRoute" targetRef="Gateway_PaymentRequired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingRoute = &quot;hospital&quot; or fundingRoute = &quot;exempt&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B8" name="self payer" sourceRef="Gateway_FundingRoute" targetRef="UserTask_CalculateCharge" />
    <bpmn:sequenceFlow id="Flow_B9" sourceRef="UserTask_RecordFundingApproval" targetRef="UserTask_CalculateCharge" />
    <bpmn:sequenceFlow id="Flow_B10" name="not required" sourceRef="Gateway_PaymentRequired" targetRef="UserTask_PrepareTreatmentBooking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentRequiredFromPatient = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B11" name="required" sourceRef="Gateway_PaymentRequired" targetRef="UserTask_CalculateCharge" />
    <bpmn:sequenceFlow id="Flow_B12" sourceRef="UserTask_CalculateCharge" targetRef="ServiceTask_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_B13" sourceRef="ServiceTask_ProcessPayment" targetRef="Gateway_PaymentStatus" />
    <bpmn:sequenceFlow id="Flow_B14" sourceRef="Boundary_Error_ProhibitedData" targetRef="UserTask_CorrectPaymentRequest" />
    <bpmn:sequenceFlow id="Flow_B15" sourceRef="Boundary_Error_PaymentRequest" targetRef="UserTask_CorrectPaymentRequest" />
    <bpmn:sequenceFlow id="Flow_B16" sourceRef="UserTask_CorrectPaymentRequest" targetRef="ServiceTask_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_B17" name="completed" sourceRef="Gateway_PaymentStatus" targetRef="Gateway_ConfirmationReceived">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = &quot;completed&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B18" name="declined" sourceRef="Gateway_PaymentStatus" targetRef="UserTask_NotifyPatientAndTeam" />
    <bpmn:sequenceFlow id="Flow_B19" name="received" sourceRef="Gateway_ConfirmationReceived" targetRef="UserTask_RecordPaymentAndReleaseAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= confirmationReceived = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B20" name="not received" sourceRef="Gateway_ConfirmationReceived" targetRef="UserTask_MarkForInvestigation" />
    <bpmn:sequenceFlow id="Flow_B21" sourceRef="UserTask_RecordPaymentAndReleaseAppointment" targetRef="UserTask_PrepareTreatmentBooking" />
    <bpmn:sequenceFlow id="Flow_B22" sourceRef="UserTask_MarkForInvestigation" targetRef="UserTask_PrepareTreatmentBooking" />
    <bpmn:sequenceFlow id="Flow_B23" sourceRef="UserTask_NotifyPatientAndTeam" targetRef="Gateway_ClinicalRisk" />
    <bpmn:sequenceFlow id="Flow_B24" name="clinical risk" sourceRef="Gateway_ClinicalRisk" targetRef="UserTask_AuthoriseUrgentTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= delayingCareIsClinicalRisk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B25" name="no risk" sourceRef="Gateway_ClinicalRisk" targetRef="Gateway_RetryPayment" />
    <bpmn:sequenceFlow id="Flow_B26" sourceRef="UserTask_AuthoriseUrgentTreatment" targetRef="UserTask_ReferChargeToFinance" />
    <bpmn:sequenceFlow id="Flow_B27" sourceRef="UserTask_ReferChargeToFinance" targetRef="UserTask_PrepareTreatmentBooking" />
    <bpmn:sequenceFlow id="Flow_B28" name="retry" sourceRef="Gateway_RetryPayment" targetRef="UserTask_CalculateCharge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryPayment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B29" name="no retry" sourceRef="Gateway_RetryPayment" targetRef="EndEvent_AppointmentNotConfirmed" />
    <bpmn:sequenceFlow id="Flow_B30" sourceRef="UserTask_PrepareTreatmentBooking" targetRef="ServiceTask_CheckTreatmentAvailability" />
    <bpmn:sequenceFlow id="Flow_B31" sourceRef="ServiceTask_CheckTreatmentAvailability" targetRef="Gateway_ExternalServiceAvailable" />
    <bpmn:sequenceFlow id="Flow_B32" sourceRef="Boundary_Error_UnauthorisedBooking" targetRef="UserTask_ReturnForAuthorisation" />
    <bpmn:sequenceFlow id="Flow_B33" sourceRef="Boundary_Error_TreatmentRequest" targetRef="UserTask_CorrectTreatmentRequest" />
    <bpmn:sequenceFlow id="Flow_B34" sourceRef="UserTask_ReturnForAuthorisation" targetRef="UserTask_AssessAndAuthoriseTreatment" />
    <bpmn:sequenceFlow id="Flow_B35" sourceRef="UserTask_CorrectTreatmentRequest" targetRef="UserTask_PrepareTreatmentBooking" />
    <bpmn:sequenceFlow id="Flow_B36" name="available" sourceRef="Gateway_ExternalServiceAvailable" targetRef="Gateway_FundingAndPaymentConfirmed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalServiceAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B37" name="unavailable" sourceRef="Gateway_ExternalServiceAvailable" targetRef="UserTask_RecordPendingBooking" />
    <bpmn:sequenceFlow id="Flow_B38" sourceRef="UserTask_RecordPendingBooking" targetRef="ServiceTask_CheckTreatmentAvailability" />
    <bpmn:sequenceFlow id="Flow_B39" name="confirmed" sourceRef="Gateway_FundingAndPaymentConfirmed" targetRef="UserTask_ConfirmTreatmentAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = &quot;completed&quot; or paymentStatus = &quot;not_required&quot; or exemptionApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B40" name="not confirmed" sourceRef="Gateway_FundingAndPaymentConfirmed" targetRef="Gateway_PaymentRequired" />
    <bpmn:sequenceFlow id="Flow_B41" sourceRef="UserTask_ConfirmTreatmentAppointment" targetRef="UserTask_PreTreatmentReview" />
    <bpmn:sequenceFlow id="Flow_B42" sourceRef="UserTask_PreTreatmentReview" targetRef="Gateway_FitToContinue" />
    <bpmn:sequenceFlow id="Flow_B43" name="fit" sourceRef="Gateway_FitToContinue" targetRef="Gateway_MoreCycles">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fitToContinue = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B44" name="not fit" sourceRef="Gateway_FitToContinue" targetRef="UserTask_RequestTreatmentModification" />
    <bpmn:sequenceFlow id="Flow_B45" sourceRef="UserTask_RequestTreatmentModification" targetRef="UserTask_AuthoriseTreatmentModification" />
    <bpmn:sequenceFlow id="Flow_B46" sourceRef="UserTask_AuthoriseTreatmentModification" targetRef="Gateway_FinancialImpact" />
    <bpmn:sequenceFlow id="Flow_B47" name="affected" sourceRef="Gateway_FinancialImpact" targetRef="UserTask_DetermineRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= affectsCharge = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B48" name="no impact" sourceRef="Gateway_FinancialImpact" targetRef="EndEvent_TreatmentModified" />
    <bpmn:sequenceFlow id="Flow_B49" sourceRef="UserTask_DetermineRefund" targetRef="UserTask_SendRefundRequest" />
    <bpmn:sequenceFlow id="Flow_B50" sourceRef="UserTask_SendRefundRequest" targetRef="UserTask_RecordRefundResult" />
    <bpmn:sequenceFlow id="Flow_B51" sourceRef="UserTask_RecordRefundResult" targetRef="EndEvent_RefundRecorded" />
    <bpmn:sequenceFlow id="Flow_B52" name="more cycles" sourceRef="Gateway_MoreCycles" targetRef="UserTask_PreTreatmentReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= moreCyclesRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B53" name="complete" sourceRef="Gateway_MoreCycles" targetRef="EndEvent_TreatmentComplete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Hospital_di" bpmnElement="Participant_Hospital" isHorizontal="true">
        <dc:Bounds x="140" y="140" width="7330" height="1310" />
        <bpmndi:BPMNLabel>
        <dc:Bounds x="146" y="1456" width="260" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Clinical_di" bpmnElement="Lane_Clinical" isHorizontal="true">
        <dc:Bounds x="140" y="330" width="7330" height="200" />
        <bpmndi:BPMNLabel>
        <dc:Bounds x="148" y="338" width="174" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OtherClinical_di" bpmnElement="Lane_OtherClinical" isHorizontal="true">
        <dc:Bounds x="140" y="530" width="7330" height="200" />

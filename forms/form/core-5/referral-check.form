{
  "id": "referral-check",
  "components": [
    {
      "type": "group",
      "label": "Referral",
      "components": [
        {
          "type": "textfield",
          "key": "referralId",
          "label": "Referral ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "textfield",
          "key": "patientId",
          "label": "Patient ID",
          "description": "The identifier the patient is known by on the hospital system.",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "textfield",
          "key": "nhsNumber",
          "label": "NHS Number",
          "description": "Ten digits. Checked against the patient register, so a patient the hospital already knows is matched rather than duplicated.",
          "validate": {
            "required": true,
            "pattern": "^[0-9]{10}$",
            "patternErrorMessage": "An NHS number is ten digits, for example 9434765919."
          }
        },
        {
          "type": "textfield",
          "key": "patientName",
          "label": "Patient Name",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textfield",
          "key": "referringOrganisation",
          "label": "Referring Organisation",
          "description": "Who the referral came from. Recorded by the validation step as the organisation to request missing information from.",
          "validate": {
            "required": true
          }
        }
      ]
    },
    {
      "type": "group",
      "label": "Documentation and Identification",
      "components": [
        {
          "type": "textarea",
          "key": "supportingDocuments",
          "label": "Supporting Information Received",
          "description": "The documents and information that arrived with the referral.",
          "validate": {
            "maxLength": 2000
          }
        },
        {
          "type": "checkbox",
          "key": "documentsComplete",
          "label": "Referral Documents Complete",
          "description": "Tick only when nothing is outstanding; leave it unticked and list the missing items where something is. A referral ticked as complete must not also list missing items, otherwise the check cannot be decided."
        },
        {
          "type": "textarea",
          "key": "missingItems",
          "label": "Missing Items",
          "description": "One item per line. Leave empty when the documentation is complete.",
          "validate": {
            "maxLength": 2000
          }
        },
        {
          "type": "checkbox",
          "key": "patientIdentificationConfirmed",
          "label": "Patient Identification Confirmed",
          "description": "The patient was identified and checked against existing records before the referral is processed.",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textfield",
          "key": "checkedBy",
          "label": "Checked By",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textarea",
          "key": "checkNotes",
          "label": "Notes",
          "validate": {
            "maxLength": 2000
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

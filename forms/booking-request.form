{
  "id": "booking-request",
  "components": [
    {
      "type": "group",
      "label": "Booking Request Details",
      "components": [
        {
          "type": "textfield",
          "key": "referralId",
          "label": "Referral ID",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textfield",
          "key": "patientId",
          "label": "Patient ID",
          "validate": {
            "required": true
          }
        },
        {
          "type": "select",
          "key": "speciality",
          "label": "Required Speciality",
          "validate": {
            "required": true
          },
          "options": [
            { "label": "Oncology", "value": "oncology" },
            { "label": "Chemotherapy", "value": "chemotherapy" },
            { "label": "General", "value": "general" }
          ]
        },
        {
          "type": "select",
          "key": "priority",
          "label": "Appointment Priority",
          "validate": {
            "required": true
          },
          "options": [
            { "label": "Urgent", "value": "urgent" },
            { "label": "Routine", "value": "routine" }
          ]
        },
        {
          "type": "number",
          "key": "requestedWindow",
          "label": "Preferred Timeframe (days)",
          "validate": {
            "required": true,
            "min": 1,
            "max": 365
          }
        },
        {
          "type": "textarea",
          "key": "patientRequirements",
          "label": "Patient Requirements (if any)"
        },
        {
          "type": "textarea",
          "key": "recipients",
          "label": "Recipients",
          "description": "Separate recipients with commas. Passed to the correspondence service when the appointment letter is sent.",
          "validate": {
            "required": true
          }
        },
        {
          "type": "select",
          "key": "documentType",
          "label": "Document Type",
          "validate": {
            "required": true
          },
          "options": [
            {
              "label": "New Patient Clinic Letter",
              "value": "new_patient_clinic_letter"
            },
            {
              "label": "Follow-up Clinic Letter",
              "value": "follow_up_clinic_letter"
            },
            {
              "label": "Appointment Letter",
              "value": "appointment_letter"
            },
            {
              "label": "Referral Outcome Letter",
              "value": "referral_outcome_letter"
            },
            {
              "label": "Deferral or Cancellation Letter",
              "value": "deferral_or_cancellation_letter"
            }
          ]
        },
        {
          "type": "select",
          "key": "channelPreference",
          "label": "Channel Preference",
          "options": [
            {
              "label": "Post",
              "value": "post"
            },
            {
              "label": "Digital",
              "value": "digital"
            },
            {
              "label": "Authorised Representative",
              "value": "authorised_representative"
            },
            {
              "label": "Accessible Format",
              "value": "accessible_format"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

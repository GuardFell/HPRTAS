<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_clinic-letter-and-pathway-monitoring" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <!-- Core process 3 of 3. Clinic letter preparation and approval, administrative processing and
     distribution, the seven-day target with weekly reminders and the one-month and three-month
     escalations, the follow-up appointment, and the cancellation or non-attendance path with
     the refund decision. Job types: send-correspondence, check-appointment-availability. -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Hospital" name="Hospital Trust (specialist service)" processRef="clinic-letter-and-pathway-monitoring" />
    <bpmn:participant id="Participant_CorrespondenceService" name="External correspondence service" />
    <bpmn:participant id="Participant_SchedulingService" name="External scheduling service" />
    <bpmn:participant id="Participant_PaymentProvider" name="External Payment Service Provider" />
    <bpmn:messageFlow id="MessageFlow_C1" name="clinic letter and follow-up correspondence" sourceRef="ServiceTask_DispatchClinicLetter" targetRef="Participant_CorrespondenceService" />
    <bpmn:messageFlow id="MessageFlow_C2" name="follow-up availability request and response" sourceRef="ServiceTask_CheckFollowUpAvailability" targetRef="Participant_SchedulingService" />
    <bpmn:messageFlow id="MessageFlow_C3" name="refund request and result" sourceRef="UserTask_SendRefundRequest" targetRef="Participant_PaymentProvider" />
  </bpmn:collaboration>
  <bpmn:process id="clinic-letter-and-pathway-monitoring" name="Clinic letter approval, distribution, pathway monitoring and follow-up" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Clinical" name="Consultant and clinical team">
        <bpmn:flowNodeRef>StartEvent_ConsultationCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PrepareAndApproveClinicLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Timer_Letter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretaries" name="Medical Secretaries">
        <bpmn:flowNodeRef>UserTask_ProcessAndDistributeLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_DispatchClinicLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LetterOnTime</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PathwayCoordinators" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>UserTask_ReviewOutstandingCorrespondence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OverdueDuration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReminderIssued</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdminManagement" name="Administrative Management Team">
        <bpmn:flowNodeRef>UserTask_ContactResponsibleConsultant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LetterDelayResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EscalatedToHigherManagement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OutpatientBookings" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>UserTask_ArrangeFollowUpAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CheckFollowUpAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowUpWithinPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ReferToPathwayTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FollowUpReferred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConfirmFollowUpAndInformPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowUpStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PathwayCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordCancellationOrNonAttendance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaidAppointmentAffected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OfferAnotherAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PathwayClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>UserTask_DetermineRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SendRefundRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RecordRefundResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RefundRecorded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ConsultationCompleted" name="Consultation or treatment review completed" />
    <bpmn:userTask id="UserTask_PrepareAndApproveClinicLetter" name="Prepare and approve the clinic letter and identify the recipients">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="consultants" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_ProcessAndDistributeLetter" name="Process the approved letter, confirm the recipients and record the distribution">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_DispatchClinicLetter" name="Distribute the clinic letter through the correspondence service">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-correspondence" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_LetterOnTime" name="Letter completed within seven days of the appointment?" />
    <bpmn:userTask id="UserTask_ReviewOutstandingCorrespondence" name="Review outstanding correspondence and issue weekly reminders">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="pathway-coordinators" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_OverdueDuration" name="How long has the letter been outstanding?" />
    <bpmn:endEvent id="EndEvent_ReminderIssued" name="Weekly reminder issued and the letter is monitored" />
    <bpmn:userTask id="UserTask_ContactResponsibleConsultant" name="Contact the responsible consultant and resolve the delay">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="administrative-management" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_LetterDelayResolved" name="Letter delay resolved through management action" />
    <bpmn:endEvent id="EndEvent_EscalatedToHigherManagement" name="Escalated to higher management" />
    <bpmn:userTask id="UserTask_ArrangeFollowUpAppointment" name="Arrange the follow-up appointment within the period requested by the clinician">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_CheckFollowUpAvailability" name="Check availability for the follow-up appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-appointment-availability" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FollowUpWithinPeriod" name="Available within the requested timeframe?" />
    <bpmn:userTask id="UserTask_ReferToPathwayTeam" name="Highlight the case and refer it to the pathway team">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_FollowUpReferred" name="Follow-up case referred to the pathway team" />
    <bpmn:userTask id="UserTask_ConfirmFollowUpAndInformPatient" name="Confirm the follow-up appointment and inform the patient">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FollowUpStatus" name="Appointment status?" />
    <bpmn:endEvent id="EndEvent_PathwayCompleted" name="Patient pathway completed" />
    <bpmn:userTask id="UserTask_RecordCancellationOrNonAttendance" name="Record the cancellation or non-attendance and decide the next step">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PaidAppointmentAffected" name="Paid appointment affected?" />
    <bpmn:exclusiveGateway id="Gateway_OfferAnotherAppointment" name="Offer another appointment?" />
    <bpmn:endEvent id="EndEvent_PathwayClosed" name="Pathway closed or patient discharged" />
    <bpmn:userTask id="UserTask_DetermineRefund" name="Determine and record whether a full or partial refund is appropriate">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_SendRefundRequest" name="Send the approved refund request to the external Payment Service Provider">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_RecordRefundResult" name="Record the refund result against the patient account">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="finance" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_RefundRecorded" name="Refund recorded against the patient account" />
    <bpmn:boundaryEvent id="Boundary_Timer_Letter" name="7 days" attachedToRef="UserTask_PrepareAndApproveClinicLetter">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_ConsultationCompleted" targetRef="UserTask_PrepareAndApproveClinicLetter" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="UserTask_PrepareAndApproveClinicLetter" targetRef="UserTask_ProcessAndDistributeLetter" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="UserTask_ProcessAndDistributeLetter" targetRef="ServiceTask_DispatchClinicLetter" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="ServiceTask_DispatchClinicLetter" targetRef="Gateway_LetterOnTime" />
    <bpmn:sequenceFlow id="Flow_C5" name="on time" sourceRef="Gateway_LetterOnTime" targetRef="UserTask_ArrangeFollowUpAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterWithinSevenDays = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C6" name="delayed" sourceRef="Gateway_LetterOnTime" targetRef="UserTask_ReviewOutstandingCorrespondence" />
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Boundary_Timer_Letter" targetRef="UserTask_ReviewOutstandingCorrespondence" />
    <bpmn:sequenceFlow id="Flow_C8" sourceRef="UserTask_ReviewOutstandingCorrespondence" targetRef="Gateway_OverdueDuration" />
    <bpmn:sequenceFlow id="Flow_C9" name="more than one month" sourceRef="Gateway_OverdueDuration" targetRef="UserTask_ContactResponsibleConsultant">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= overdueDuration = &quot;over_one_month&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C10" name="more than three months" sourceRef="Gateway_OverdueDuration" targetRef="EndEvent_EscalatedToHigherManagement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= overdueDuration = &quot;over_three_months&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C11" name="within one month" sourceRef="Gateway_OverdueDuration" targetRef="EndEvent_ReminderIssued" />
    <bpmn:sequenceFlow id="Flow_C12" sourceRef="UserTask_ContactResponsibleConsultant" targetRef="EndEvent_LetterDelayResolved" />
    <bpmn:sequenceFlow id="Flow_C13" sourceRef="UserTask_ArrangeFollowUpAppointment" targetRef="ServiceTask_CheckFollowUpAvailability" />
    <bpmn:sequenceFlow id="Flow_C14" sourceRef="ServiceTask_CheckFollowUpAvailability" targetRef="Gateway_FollowUpWithinPeriod" />
    <bpmn:sequenceFlow id="Flow_C15" name="within the period" sourceRef="Gateway_FollowUpWithinPeriod" targetRef="UserTask_ConfirmFollowUpAndInformPatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= withinRequestedWindow = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C16" name="outside the period" sourceRef="Gateway_FollowUpWithinPeriod" targetRef="UserTask_ReferToPathwayTeam" />
    <bpmn:sequenceFlow id="Flow_C17" sourceRef="UserTask_ReferToPathwayTeam" targetRef="EndEvent_FollowUpReferred" />
    <bpmn:sequenceFlow id="Flow_C18" sourceRef="UserTask_ConfirmFollowUpAndInformPatient" targetRef="Gateway_FollowUpStatus" />
    <bpmn:sequenceFlow id="Flow_C19" name="attended" sourceRef="Gateway_FollowUpStatus" targetRef="EndEvent_PathwayCompleted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentStatus = &quot;attended&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C20" name="cancelled or not attended" sourceRef="Gateway_FollowUpStatus" targetRef="UserTask_RecordCancellationOrNonAttendance" />
    <bpmn:sequenceFlow id="Flow_C21" sourceRef="UserTask_RecordCancellationOrNonAttendance" targetRef="Gateway_PaidAppointmentAffected" />
    <bpmn:sequenceFlow id="Flow_C22" name="paid" sourceRef="Gateway_PaidAppointmentAffected" targetRef="UserTask_DetermineRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paidAppointment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C23" name="not paid" sourceRef="Gateway_PaidAppointmentAffected" targetRef="Gateway_OfferAnotherAppointment" />
    <bpmn:sequenceFlow id="Flow_C24" sourceRef="UserTask_DetermineRefund" targetRef="UserTask_SendRefundRequest" />
    <bpmn:sequenceFlow id="Flow_C25" sourceRef="UserTask_SendRefundRequest" targetRef="UserTask_RecordRefundResult" />
    <bpmn:sequenceFlow id="Flow_C26" sourceRef="UserTask_RecordRefundResult" targetRef="EndEvent_RefundRecorded" />
    <bpmn:sequenceFlow id="Flow_C27" name="yes" sourceRef="Gateway_OfferAnotherAppointment" targetRef="UserTask_ArrangeFollowUpAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= offerAnotherAppointment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C28" name="no" sourceRef="Gateway_OfferAnotherAppointment" targetRef="EndEvent_PathwayClosed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Hospital_di" bpmnElement="Participant_Hospital" isHorizontal="true">
        <dc:Bounds x="140" y="140" width="4120" height="830" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="150" y="976" width="200" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Clinical_di" bpmnElement="Lane_Clinical" isHorizontal="true">
        <dc:Bounds x="140" y="170" width="4120" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Secretaries_di" bpmnElement="Lane_Secretaries" isHorizontal="true">
        <dc:Bounds x="140" y="300" width="4120" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PathwayCoordinators_di" bpmnElement="Lane_PathwayCoordinators" isHorizontal="true">
        <dc:Bounds x="140" y="430" width="4120" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AdminManagement_di" bpmnElement="Lane_AdminManagement" isHorizontal="true">
        <dc:Bounds x="140" y="560" width="4120" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OutpatientBookings_di" bpmnElement="Lane_OutpatientBookings" isHorizontal="true">
        <dc:Bounds x="140" y="690" width="4120" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Finance_di" bpmnElement="Lane_Finance" isHorizontal="true">
        <dc:Bounds x="140" y="820" width="4120" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_CorrespondenceService_di" bpmnElement="Participant_CorrespondenceService" isHorizontal="true">
        <dc:Bounds x="4460" y="335" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_SchedulingService_di" bpmnElement="Participant_SchedulingService" isHorizontal="true">
        <dc:Bounds x="4460" y="725" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_PaymentProvider_di" bpmnElement="Participant_PaymentProvider" isHorizontal="true">
        <dc:Bounds x="4460" y="855" width="330" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_ConsultationCompleted_di" bpmnElement="StartEvent_ConsultationCompleted">
        <dc:Bounds x="227" y="217" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="94" y="259" width="302" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_PrepareAndApproveClinicLetter_di" bpmnElement="UserTask_PrepareAndApproveClinicLetter">
        <dc:Bounds x="345" y="195" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="225" y="281" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ProcessAndDistributeLetter_di" bpmnElement="UserTask_ProcessAndDistributeLetter">
        <dc:Bounds x="495" y="325" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="375" y="411" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_DispatchClinicLetter_di" bpmnElement="ServiceTask_DispatchClinicLetter">
        <dc:Bounds x="645" y="325" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="411" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LetterOnTime_di" bpmnElement="Gateway_LetterOnTime" isMarkerVisible="true">
        <dc:Bounds x="820" y="340" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="675" y="312" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ReviewOutstandingCorrespondence_di" bpmnElement="UserTask_ReviewOutstandingCorrespondence">
        <dc:Bounds x="945" y="455" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="825" y="541" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OverdueDuration_di" bpmnElement="Gateway_OverdueDuration" isMarkerVisible="true">
        <dc:Bounds x="1120" y="470" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="998" y="442" width="295" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ReminderIssued_di" bpmnElement="EndEvent_ReminderIssued">
        <dc:Bounds x="1277" y="477" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1125" y="519" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ContactResponsibleConsultant_di" bpmnElement="UserTask_ContactResponsibleConsultant">
        <dc:Bounds x="1395" y="585" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1275" y="671" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LetterDelayResolved_di" bpmnElement="EndEvent_LetterDelayResolved">
        <dc:Bounds x="1577" y="607" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1426" y="649" width="338" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_EscalatedToHigherManagement_di" bpmnElement="EndEvent_EscalatedToHigherManagement">
        <dc:Bounds x="1727" y="607" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1637" y="649" width="216" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ArrangeFollowUpAppointment_di" bpmnElement="UserTask_ArrangeFollowUpAppointment">
        <dc:Bounds x="1845" y="715" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1725" y="801" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_CheckFollowUpAvailability_di" bpmnElement="ServiceTask_CheckFollowUpAvailability">
        <dc:Bounds x="1995" y="715" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1875" y="801" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FollowUpWithinPeriod_di" bpmnElement="Gateway_FollowUpWithinPeriod" isMarkerVisible="true">
        <dc:Bounds x="2170" y="730" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2048" y="702" width="295" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ReferToPathwayTeam_di" bpmnElement="UserTask_ReferToPathwayTeam">
        <dc:Bounds x="2295" y="715" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2175" y="801" width="340" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_FollowUpReferred_di" bpmnElement="EndEvent_FollowUpReferred">
        <dc:Bounds x="2477" y="737" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2340" y="779" width="310" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ConfirmFollowUpAndInformPatient_di" bpmnElement="UserTask_ConfirmFollowUpAndInformPatient">
        <dc:Bounds x="2595" y="715" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2475" y="801" width="340" height="20" />
        </bpmndi:BPMNLabel>

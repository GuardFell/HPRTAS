# ---------------------------------------------------------------------------
# Connection configuration template for the HPRTAS external workers.
#
# Copy this file to `.env` (same directory) and adjust the values for your
# machine. `.env` is ignored by git, so each member can keep their own copy.
#
# The Camunda 8 Node SDK reads these environment variables itself; the worker
# code only reads the ones marked [worker].
# ---------------------------------------------------------------------------

# --- Zeebe gRPC gateway -----------------------------------------------------
# Camunda 8 Run exposes the Zeebe API on localhost:26500.
# The protocol is part of the value: grpc:// for a local, insecure connection,
# grpcs:// for a secured one. Because the address carries the protocol, no
# separate TLS setting is needed: the SDK warns and ignores the older
# CAMUNDA_SECURE_CONNECTION / ZEEBE_INSECURE_CONNECTION settings when this is
# set, so do not add them.
ZEEBE_GRPC_ADDRESS=grpc://localhost:26500

# --- Authentication --------------------------------------------------------
# Camunda 8 Run is installed unsecured (camunda.security.authentication is
# disabled for API access), so no credentials are sent and no tokens are
# fetched. Set this to BASIC or OAUTH if the group ever points the workers at
# a secured cluster.
CAMUNDA_AUTH_STRATEGY=NONE

# Only needed when CAMUNDA_AUTH_STRATEGY is not NONE:
# CAMUNDA_BASIC_AUTH_USERNAME=demo
# CAMUNDA_BASIC_AUTH_PASSWORD=demo

# --- Worker behaviour [worker] --------------------------------------------
# Log level: error | warn | info | debug | silly. Default: info.
HPRTAS_LOG_LEVEL=info

# Optional path for a log file. The worker log is required evidence in
# `tests/evidence/`, so capturing it to a file makes it easy to attach.
# Relative paths are resolved from the `workers/` directory.
# HPRTAS_LOG_FILE=logs/workers.log

# --- Simulated service outcomes [worker] ----------------------------------
# Leave these unset for the normal behaviour: the outcome is then decided by
# the scenario data, which keeps the test runs reproducible. Set one to force a
# single outcome for every job of that worker, which is how the demonstration
# and the exception scenarios are driven without editing code.
#
# scheduling:  available | outside_window | none
# treatment:   available | unavailable
# payment:     completed | declined | success_no_confirmation
# correspondence: dispatched
# HPRTAS_SIM_SCHEDULING=available
# HPRTAS_SIM_TREATMENT=unavailable
# HPRTAS_SIM_PAYMENT=declined

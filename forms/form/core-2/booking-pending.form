{
  "id": "booking-pending",
  "components": [
    {
      "type": "group",
      "label": "Pending Booking",
      "components": [
        {
          "type": "textfield",
          "key": "treatmentRequestId",
          "label": "Treatment Request ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example REF-2026-0001."
          }
        },
        {
          "type": "select",
          "key": "pendingReason",
          "label": "Reason the Booking Is Pending",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Treatment Service Unavailable",
              "value": "service_unavailable"
            },
            {
              "label": "Awaiting Funding Approval",
              "value": "awaiting_funding"
            },
            {
              "label": "Awaiting Clinical Authorisation",
              "value": "awaiting_authorisation"
            }
          ]
        },
        {
          "type": "textfield",
          "key": "notifiedTeam",
          "label": "Team Notified",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "checkbox",
          "key": "attemptRecorded",
          "label": "Attempt Recorded",
          "description": "The attempt is recorded so a further attempt is made without creating a duplicate appointment.",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textfield",
          "key": "recordedBy",
          "label": "Recorded By",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textarea",
          "key": "pendingNotes",
          "label": "Notes",
          "validate": {
            "maxLength": 2000
          }
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

{
  "id": "escalation",
  "components": [
    {
      "type": "group",
      "label": "Escalation Details",
      "path": "escalation",
      "elements": [
        {
          "type": "textfield",
          "key": "caseId",
          "label": "Case / Referral ID",
          "validate": { "required": true }
        },
        {
          "type": "select",
          "key": "escalationLevel",
          "label": "Escalation Level",
          "validate": { "required": true },
          "options": [
            { "label": "Administrative Manager", "value": "admin_manager" },
            { "label": "Higher Management", "value": "higher_management" }
          ]
        },
        {
          "type": "textarea",
          "key": "escalationReason",
          "label": "Reason for Escalation",
          "validate": { "required": true }
        },
        {
          "type": "number",
          "key": "daysOutstanding",
          "label": "Days Outstanding"
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

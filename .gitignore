# Operating system files
Thumbs.db
Desktop.ini
.DS_Store

# Office lock files (created while a document is open)
~$*

# Editors and IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo

# Node.js (external workers, if the Node SDK is used)
node_modules/
npm-debug.log*
yarn-error.log*
.env
.env.local

# Per-machine worker overrides (a copy of config/workers.default.json). The
# agreed defaults are committed as workers/config/workers.default.json; this
# file is for values that must not be shared, such as another gateway address.
workers/config/workers.local.json

# Worker logs captured through HPRTAS_LOG_FILE
workers/logs/

# Java (external workers, if the Java SDK is used)
target/
*.class
*.jar
!**/maven-wrapper.jar

# Camunda engine runtime data and logs - never commit runtime state
camunda-data/
*.mv.db
*.trace.db
zeebe-data/
logs/
*.log

# Local scratch
tmp/
scratch/

{
  "id": "appointment-confirmation",
  "components": [
    {
      "type": "group",
      "label": "Confirmation",
      "components": [
        {
          "type": "textfield",
          "key": "patientId",
          "label": "Patient ID",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example PAT-1001."
          }
        },
        {
          "type": "textfield",
          "key": "appointmentReference",
          "label": "Appointment Reference",
          "description": "The appointment this contact is about, as the hospital booked it.",
          "validate": {
            "required": true,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$",
            "patternErrorMessage": "Use the reference as the system writes it, for example APPT-2026-0001."
          }
        },
        {
          "type": "select",
          "key": "confirmationOutcome",
          "label": "Outcome of the Confirmation Contact",
          "description": "What happened when the appointment was confirmed with the patient. Confirmed and No Response keep the appointment; a reschedule records a new request; a decline or a hospital cancellation releases it.",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Appointment Confirmed",
              "value": "confirmed"
            },
            {
              "label": "No Response From the Patient",
              "value": "no_response"
            },
            {
              "label": "Patient Requested a Different Date",
              "value": "reschedule_requested"
            },
            {
              "label": "Declined by the Patient",
              "value": "declined_by_patient"
            },
            {
              "label": "Cancelled by the Hospital",
              "value": "cancelled_by_hospital"
            }
          ]
        },
        {
          "type": "select",
          "key": "confirmationBasis",
          "label": "Basis for Confirming",
          "description": "The appointment is confirmed only once the funding route and, where required, the payment, an authorised exemption or a recorded payment arrangement are in place. Where the outcome above is not Confirmed, record Not Applicable.",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "Funding in Place",
              "value": "funding_in_place"
            },
            {
              "label": "Payment Settled",
              "value": "payment_settled"
            },
            {
              "label": "Payment Not Required",
              "value": "payment_not_required"
            },
            {
              "label": "Exemption Authorised",
              "value": "exemption_authorised"
            },
            {
              "label": "Payment Arrangement Recorded",
              "value": "payment_arrangement"
            },
            {
              "label": "Not Applicable (Appointment Not Confirmed)",
              "value": "not_applicable"
            }
          ]
        },
        {
          "type": "datetime",
          "subtype": "date",
          "dateLabel": "Date",
          "key": "confirmationDate",
          "label": "Date of the Confirmation Contact",
          "validate": {
            "required": true
          }
        },
        {
          "type": "textfield",
          "key": "confirmedBy",
          "label": "Confirmed By",
          "validate": {
            "required": true,
            "pattern": "^(?=.*[A-Za-z]).+$",
            "patternErrorMessage": "Enter a name or role that contains letters.",
            "maxLength": 120
          }
        },
        {
          "type": "textarea",
          "key": "confirmationNotes",
          "label": "Notes",
          "validate": {
            "maxLength": 2000
          }
        }
      ]
    },
    {
      "type": "group",
      "label": "Notification",
      "components": [
        {
          "type": "textarea",
          "key": "recipients",
          "label": "Recipients",
          "description": "Separate recipients with commas. Passed to the correspondence service.",
          "validate": {
            "required": true,
            "maxLength": 2000
          }
        },
        {
          "type": "select",
          "key": "documentType",
          "label": "Document Type",
          "validate": {
            "required": true
          },
          "values": [
            {
              "label": "New Patient Clinic Letter",
              "value": "new_patient_clinic_letter"
            },
            {
              "label": "Follow-up Clinic Letter",
              "value": "follow_up_clinic_letter"
            },
            {
              "label": "Appointment Letter",
              "value": "appointment_letter"
            },
            {
              "label": "Referral Outcome Letter",
              "value": "referral_outcome_letter"
            },
            {
              "label": "Deferral or Cancellation Letter",
              "value": "deferral_or_cancellation_letter"
            }
          ]
        },
        {
          "type": "select",
          "key": "channelPreference",
          "label": "Channel Preference",
          "description": "Where the patient is known to the hospital, the preference already recorded for them is used when this is left empty.",
          "values": [
            {
              "label": "Post",
              "value": "post"
            },
            {
              "label": "Digital",
              "value": "digital"
            },
            {
              "label": "Authorised Representative",
              "value": "authorised_representative"
            },
            {
              "label": "Accessible Format",
              "value": "accessible_format"
            }
          ]
        }
      ]
    }
  ],
  "schemaVersion": 1,
  "type": "default",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0"
}

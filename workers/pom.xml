<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>uk.ac.uwe.hprtas</groupId>
  <artifactId>external-workers</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>HPRTAS external workers</name>
  <description>
    External workers for the Hospital Patient Referral, Treatment and Administration System
    operational process. Contains the workers, the simulated external services they call, and the
    configuration templates.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- The engine runs Camunda 8 Run 8.9.19, so the client is pinned to the same release. -->
    <camunda.client.version>8.9.19</camunda.client.version>
    <junit.version>5.11.4</junit.version>

    <!--
      The engine tests are tagged `engine` and excluded by default, so `mvn test` needs no engine,
      exactly as `npm test` did. Run them with `mvn test -Pengine`, or one at a time with
      `mvn test -Pengine -Dtest=SmokeTest`.
    -->
    <surefire.excludedGroups>engine</surefire.excludedGroups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>camunda-client-java</artifactId>
      <version>${camunda.client.version}</version>
    </dependency>

    <!--
      The client logs through slf4j. Without a binding it complains on every start, and with the
      default binding it buries the JSON evidence the workers write. `simple` is configured to
      error level in Main, which is what the Node SDK's ZEEBE_CLIENT_LOG_LEVEL=ERROR did.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.16</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>hprtas-external-workers</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>

      <!--
        `mvn compile exec:java` runs the workers. Passing the check argument instead validates the
        configuration and the wiring without connecting to an engine; the root README gives the
        exact command.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>uk.ac.uwe.hprtas.workers.Main</mainClass>
        </configuration>
      </plugin>

      <!-- A self-contained jar, so the workers can also be started with `java -jar`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>uk.ac.uwe.hprtas.workers.Main</mainClass>
                </transformer>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- `mvn test -Pengine` runs the smoke and end-to-end runs, which need the engine. -->
    <profile>
      <id>engine</id>
      <properties>
        <!-- Nothing is tagged this, so the default exclusion stops excluding anything. -->
        <surefire.excludedGroups>no-such-tag</surefire.excludedGroups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>engine</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

        <bpmndi:BPMNLabel>
          <dc:Bounds x="1878" y="1480" width="121" height="21" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_AM_EscalateHigher_di" bpmnElement="N_AM_EscalateHigher">
        <dc:Bounds x="1660" y="1420" width="150" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1676" y="1504" width="117" height="21" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_AM_EscalateManager_di" bpmnElement="N_AM_EscalateManager">
        <dc:Bounds x="1360" y="1400" width="150" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1357" y="1484" width="156" height="21" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="166" y="330" />
        <di:waypoint x="260" y="330" />
        <di:waypoint x="260" y="340" />
        <di:waypoint x="280" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="430" y="340" />
        <di:waypoint x="510" y="340" />
        <di:waypoint x="510" y="320" />
        <di:waypoint x="530" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="600" y="360" />
        <di:waypoint x="600" y="720" />
        <di:waypoint x="840" y="720" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="990" y="720" />
        <di:waypoint x="1100" y="720" />
        <di:waypoint x="1100" y="740" />
        <di:waypoint x="1120" y="740" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="1170" y="740" />
        <di:waypoint x="1340" y="740" />
        <di:waypoint x="1340" y="710" />
        <di:waypoint x="1360" y="710" />
        <bpmndi:BPMNLabel>
